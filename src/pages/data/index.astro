---
import HowToCite from "../../components/HowToCite.astro";
import PageSection from "../../components/PageSection.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createDatasetCitation, dataRepositoryUrl } from "../../data/citations.ts";
import { formatGenusCount } from "../../data/format.ts";
import { formatFileSize, getDatasetFiles } from "../../data/indexes.ts";
import { bindingsSectionId } from "../../data/packages.ts";
import { getSiteData } from "../../data/site-data.ts";
import { createDatasetStructuredData } from "../../data/structured-data.ts";

const siteData = getSiteData();
const baseUrl = import.meta.env.BASE_URL;
const metadata = siteData.metadata;
const files = getDatasetFiles();
const dataRepository = dataRepositoryUrl;
const fileBaseUrl = dataRepository + "/blob/main/dist/";
const builtDate = new Date(metadata.built_at).toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

const citation = createDatasetCitation(metadata);
const structuredData = Astro.site ? createDatasetStructuredData(metadata, files, new URL(Astro.url.pathname, Astro.site).href) : undefined;
---

<BaseLayout title="Data" description="Download the Open Paleo dataset as JSON, YAML, Newick, NEXUS or BibTeX, and find out how to cite it." navigationItem="data" structuredData={structuredData}>
    <div class="data-page">
        <header class="data-header">
            <h1>Data</h1>
            <p class="data-summary">
                Everything this site tells you about genera, clades, rock units and references comes from the Open
                Paleo dataset. You’re free to use it under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>,
                as long as you credit Open Paleo contributors. The files below are built from the dataset’s source in the
                <a href={dataRepository}>open-paleo/data repository</a> on GitHub.
            </p>
            <p class="data-summary">
                Not everything on the site is under that license, though. Each outline beside a genus or clade name has
                its own license, named in its credit line, and the maps, fonts and software are other people’s work under
                their own licenses. For the full list, see <a href={baseUrl + "licenses/"}>Licenses</a>.
            </p>
        </header>

        <dl class="release-facts">
            <div>
                <dt>Release</dt>
                <dd class="figures">{metadata.version}</dd>
            </div>
            <div>
                <dt>Schema version</dt>
                <dd class="figures">{metadata.schema_version}</dd>
            </div>
            <div>
                <dt>Built</dt>
                <dd>{builtDate}</dd>
            </div>
            <div>
                <dt>Contents</dt>
                <dd>{formatGenusCount(metadata.genus_count)}, {metadata.clade_count} clades</dd>
            </div>
        </dl>

        <PageSection title="Downloads">
            <div class="table-scroll" tabindex="0" role="region" aria-label="Downloads">
                <table>
                    <thead>
                        <tr>
                            <th scope="col">File</th>
                            <th scope="col">Contents</th>
                            <th scope="col" class="numeric">Size</th>
                        </tr>
                    </thead>
                    <tbody>
                        {files.map((file) => (
                            <tr>
                                <td class="file-name"><a href={fileBaseUrl + file.name}>{file.name}</a></td>
                                <td>{file.description}</td>
                                <td class="numeric figures">{file.sizeBytes === undefined ? "" : formatFileSize(file.sizeBytes)}</td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            </div>
            <p class="section-note">
                Writing code that reads the dataset? Use the JSON or YAML file and check it against the schema. These files
                are the dataset’s stable, versioned output; for what a change to each part of the version number means,
                see the <a href={dataRepository + "/blob/main/docs/VERSIONING.md"}>versioning policy</a>.
            </p>
            <aside class="bindings-callout" aria-labelledby="bindings-callout-title">
                <h3 class="bindings-callout-title" id="bindings-callout-title">Official typed bindings</h3>
                <p>
                    We also publish official bindings that describe the format of every record: TypeScript types on npm and
                    Pydantic models for Python on PyPI, each with the JSON Schema. To install and use them, see
                    <a href={baseUrl + "developers/#" + bindingsSectionId}>Developers</a>.
                </p>
            </aside>
        </PageSection>

        <PageSection title="How to cite">
            <p>Please cite the release you used, so others can check your work against the same data:</p>
            <HowToCite citation={citation} subject="the dataset" />
            <p class="section-note">
                The dataset is built from published literature, so if your work draws on it, please consider citing the
                original papers too. You’ll find every one in <a href={fileBaseUrl + "references.bib"}>references.bib</a>.
            </p>
        </PageSection>
    </div>
</BaseLayout>

<script>
    import "../../scripts/copy-buttons.ts";
</script>

<style>
    .data-page
    {
        display: grid;
        gap: var(--space-7);
    }

    .data-header
    {
        display: grid;
        gap: var(--space-4);
        max-width: var(--measure);
    }

    h1
    {
        font-size: var(--text-display);
        font-weight: 800;
    }

    .release-facts
    {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-4) var(--space-7);
        margin: 0;
        font-family: var(--font-sans);
    }

    .release-facts dt
    {
        color: var(--color-muted);
        font-size: var(--text-small);
    }

    .release-facts dd
    {
        margin: 0;
        font-size: var(--text-lede);
        font-weight: 700;
    }

    .table-scroll
    {
        overflow-x: auto;
    }

    .file-name
    {
        font-family: var(--font-sans);
        white-space: nowrap;
    }

    .numeric
    {
        text-align: right;
        white-space: nowrap;
    }

    .section-note
    {
        max-width: var(--measure);
        color: var(--color-muted);
        font-size: var(--text-interface);
    }

    /* A box in the accent's soft color sets the pointer to the bindings apart from the notes. */
    .bindings-callout
    {
        display: grid;
        gap: var(--space-2);
        max-width: var(--measure);
        padding: var(--space-4) var(--space-5);
        background: var(--color-accent-soft);
        border-left: 3px solid var(--color-accent);
        border-radius: var(--radius);
        font-size: var(--text-interface);
    }

    .bindings-callout-title
    {
        font-family: var(--font-sans);
        font-size: var(--text-interface);
        font-weight: 700;
    }
</style>

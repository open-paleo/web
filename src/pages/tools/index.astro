---
import BetaBadge from "../../components/BetaBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { findLicensedWork, readWorkVersion } from "../../data/licenses.ts";

const baseUrl = import.meta.env.BASE_URL;
// The versions the site runs, from the installed packages, which the tools' update workflow pins.
const outlineTracerVersion = readWorkVersion(findLicensedWork("outline-tracer"), process.cwd());
const treeExtractorVersion = readWorkVersion(findLicensedWork("tree-extractor"), process.cwd());
---

<BaseLayout title="Tools" description="Browser tools that turn published figures into data: trace an outline from a skeletal reconstruction, or read a phylogenetic tree from a figure." navigationItem="tools">
    <div class="tools-page">
        <header class="tools-header">
            <h1>Tools</h1>
            <p class="tools-summary">These tools help you turn figures from published papers into data. They run entirely in your browser, so your figures never leave your computer.</p>
        </header>

        <ul class="tool-list">
            <li>
                <h2><a href={baseUrl + "tools/outline-tracer/"}>Outline tracer</a> <BetaBadge version={outlineTracerVersion} /></h2>
                <p>
                    Turn a skeletal reconstruction into the outline shown beside a genus or clade name. The tracer keeps
                    the animal, drops labels and scale bars, and fills in the body. You check the outline against the
                    figure, then copy its record for Open Paleo’s media repository.
                </p>
            </li>
            <li>
                <h2><a href={baseUrl + "tools/tree-extractor/"}>Tree extractor</a> <BetaBadge version={treeExtractorVersion} /></h2>
                <p>
                    Read a phylogenetic tree from a published figure and save it as Newick or NEXUS. The extractor
                    traces the branches, reads the tip labels and matches them to names in Open Paleo. Then you correct
                    anything it got wrong.
                </p>
            </li>
        </ul>
    </div>
</BaseLayout>

<style>
    .tools-page
    {
        display: grid;
        gap: var(--space-6);
    }

    .tools-header
    {
        display: grid;
        gap: var(--space-3);
    }

    h1
    {
        font-size: var(--text-display);
        font-weight: 800;
    }

    .tools-summary
    {
        max-width: var(--measure);
        color: var(--color-muted);
    }

    .tool-list
    {
        display: grid;
        gap: var(--space-5);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tool-list li
    {
        display: grid;
        gap: var(--space-2);
        max-width: var(--measure);
        padding-bottom: var(--space-5);
        border-bottom: 1px solid var(--color-line);
    }

    h2
    {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-3);
        font-size: var(--text-heading-2);
    }
</style>

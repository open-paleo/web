---
import BetaBadge from "../../components/BetaBadge.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { findLicensedWork, readWorkVersion } from "../../data/licenses.ts";

const baseUrl = import.meta.env.BASE_URL;
// The versions the site runs, from the installed packages, which the tools' update workflow pins.
const outlineTracerVersion = readWorkVersion(findLicensedWork("outline-tracer"), process.cwd());
const treeExtractorVersion = readWorkVersion(findLicensedWork("tree-extractor"), process.cwd());
---

<BaseLayout title="Tools" description="Tools for working with the Open Paleo dataset and the literature behind it, in your browser." navigationItem="tools">
    <div class="tools-page">
        <header class="tools-header">
            <h1>Tools</h1>
            <p class="tools-summary">These tools help with the dataset and the literature behind it. They run entirely in your browser.</p>
        </header>

        <ul class="tool-list">
            <li>
                <h2><a href={baseUrl + "tools/outline-tracer/"}>Outline tracer</a> <BetaBadge version={outlineTracerVersion} /></h2>
                <p>
                    Traces a skeletal reconstruction into the outline a genus or clade page shows, and writes its record
                    for Open Paleo’s images. The tracer keeps the animal, drops labels and scale bars, and fills in the
                    body, and then you check the outline against the figure. Your figure never leaves your computer.
                </p>
            </li>
            <li>
                <h2><a href={baseUrl + "tools/tree-extractor/"}>Tree extractor</a> <BetaBadge version={treeExtractorVersion} /></h2>
                <p>
                    Reads a phylogenetic tree from a published figure and saves it as Newick or Nexus. It traces the
                    branches, reads the tip labels and matches them to names in Open Paleo, and then you correct
                    anything it got wrong. Your figure never leaves your computer.
                </p>
            </li>
        </ul>
    </div>
</BaseLayout>

<style>
    .tools-page
    {
        display: grid;
        gap: var(--space-6);
    }

    .tools-header
    {
        display: grid;
        gap: var(--space-3);
    }

    h1
    {
        font-size: var(--text-display);
        font-weight: 800;
    }

    .tools-summary
    {
        max-width: var(--measure);
        color: var(--color-muted);
    }

    .tool-list
    {
        display: grid;
        gap: var(--space-5);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .tool-list li
    {
        display: grid;
        gap: var(--space-2);
        max-width: var(--measure);
        padding-bottom: var(--space-5);
        border-bottom: 1px solid var(--color-line);
    }

    h2
    {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-3);
        font-size: var(--text-heading-2);
    }
</style>

---
import BetaBadge from "../../../components/BetaBadge.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { findLicensedWork, readWorkVersion } from "../../../data/licenses.ts";
import { ocrSitePaths } from "../../../integrations/ocr-files.ts";

const baseUrl = import.meta.env.BASE_URL;
const sourceUrl = "https://github.com/open-paleo/tools/tree/main/tree-extractor";
const extractorVersion = readWorkVersion(findLicensedWork("tree-extractor"), process.cwd());
---

<BaseLayout title="Tree extractor" description="Read a phylogenetic tree from a published figure and save it as Newick or NEXUS, right in your browser." navigationItem="tools">
    <div class="tool-page">
        <header class="tool-header">
            <h1><span>Tree extractor</span> <BetaBadge version={extractorVersion} /></h1>
            <p class="tool-summary">Read a phylogenetic tree from a published figure and save it as Newick or NEXUS.</p>
            <ol class="tool-steps">
                <li>Choose an image of a cladogram.</li>
                <li>Select Extract tree. The extractor traces the branches, reads the tip labels and matches them to names in Open Paleo.</li>
                <li>Check the tree against the figure, and correct anything it got wrong.</li>
                <li>Download the tree as Newick (.nwk) or NEXUS (.nex).</li>
            </ol>
            <ul class="tool-notes">
                <li>It runs entirely in your browser, so your figure is never uploaded.</li>
                <li>The first time it reads labels, it downloads about 10 MB of text-recognition data from this site, which your browser keeps for next time. If you tick “Read unmatched labels a second time”, it downloads about 12 MB more for a second text-recognition engine, also only once.</li>
                <li>It’s still in beta, so check every tree against its figure before you use it. For the kinds of figure it handles well, refer to <a href={sourceUrl + "#status"}>its documentation</a>.</li>
            </ul>
        </header>

        <noscript>
            <p class="tool-unavailable">The tree extractor needs JavaScript. To run it from the command line instead, see <a href={sourceUrl}>its repository</a>.</p>
        </noscript>

        <tree-extractor
            known-names-url={baseUrl + "tools/tree-extractor/known-names.txt"}
            known-clades-url={baseUrl + "tools/tree-extractor/known-clades.txt"}
            tesseract-worker-path={baseUrl + ocrSitePaths.worker}
            tesseract-core-path={baseUrl + ocrSitePaths.core + "/"}
            tesseract-lang-path={baseUrl + ocrSitePaths.language}
            data-onnx-runtime-path={baseUrl + ocrSitePaths.onnxRuntime + "/"}
            data-paddle-model-path={baseUrl + ocrSitePaths.paddleModel + "/"}
        ></tree-extractor>

        <p class="tool-source">
            The tree extractor is open source. Its code is in <a href={sourceUrl}>open-paleo/tools</a>, along with a
            command-line version that reads whole folders of figures.
        </p>
    </div>
</BaseLayout>

<script>
    import "../../../scripts/tree-extractor.ts";
</script>

<style>
    .tool-page
    {
        display: grid;
        gap: var(--space-5);
    }

    .tool-header
    {
        display: grid;
        gap: var(--space-3);
    }

    h1
    {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-4);
        font-size: var(--text-display);
        font-weight: 800;
    }

    .tool-summary,
    .tool-steps,
    .tool-notes,
    .tool-source
    {
        max-width: var(--measure);
    }

    .tool-steps
    {
        display: grid;
        gap: var(--space-1);
        margin: 0;
        padding-left: var(--space-5);
    }

    .tool-notes
    {
        display: grid;
        gap: var(--space-1);
        margin: 0;
        padding-left: var(--space-5);
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-interface);
    }

    .tool-source,
    .tool-unavailable
    {
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-interface);
    }

    /* The tool reads its colors, fonts and corners from these, so it follows the site's theme in
       light and dark mode. */
    tree-extractor
    {
        --te-background: var(--color-background);
        --te-surface: var(--color-surface);
        --te-ink: var(--color-ink);
        --te-muted: var(--color-muted);
        --te-line: var(--color-line);
        --te-accent: var(--color-accent);
        --te-accent-soft: var(--color-accent-soft);
        --te-on-accent: var(--color-surface);
        --te-caution: var(--color-caution);
        --te-danger: var(--color-danger);
        --te-font-sans: var(--font-sans);
        --te-font-mono: var(--font-mono);
        --te-radius: var(--radius);
        --te-canvas-height: clamp(24rem, calc(100svh - 16rem), 44rem);
    }
</style>

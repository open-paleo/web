---
import type { GetStaticPathsOptions, Page } from "astro";

import BaseLayout from "../../layouts/BaseLayout.astro";
import type { NewsPost } from "../../data/news.ts";
import { findFirstParagraph, formatNewsDate, formatNewsDateValue, newsPageSize } from "../../data/news.ts";
import { getNewsPosts } from "../../data/news-collection.ts";

/**
 * The page's properties: one page of the list, from Astro's paginate().
 */
type Props = {
    /**
     * The posts on this page, and the addresses of the pages before and after it.
     */
    page: Page<NewsPost>;
};

/**
 * Create the pages of the News list: news/ with the newest posts, then news/2/, news/3/ and on.
 *
 * @param options - Astro's options, with its paginate().
 * @returns The pages.
 */
export async function getStaticPaths(options: GetStaticPathsOptions)
{
    return options.paginate(await getNewsPosts(), { pageSize: newsPageSize });
}

const { page } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const isFirstPage = page.currentPage === 1;
const title = isFirstPage ? "News" : "News, page " + page.currentPage + " of " + page.lastPage;
---

<BaseLayout title={title} description="News from Open Paleo: new features on the site, releases of the dataset and other announcements." navigationItem="news">
    <div class="news-page">
        <header class="news-header">
            <h1>News</h1>
            {isFirstPage
                ? <p class="news-summary">
                    Announcements from Open Paleo: new features on the site, new releases of the dataset and anything else worth
                    telling you about. To follow along, add the <a href={baseUrl + "news.xml"}>news feed</a> to your feed reader.
                </p>
                : <p class="news-summary">Page {page.currentPage} of {page.lastPage}, older posts. The newest are on the <a href={baseUrl + "news/"}>first page</a>.</p>}
            {/* Shown by the script, which it needs; it loads every post's title, on any page of the list.
               Left out while there are no posts to find. */}
            {page.total > 0 && (
                <form class="news-find" role="search" aria-label="Find a news post" hidden>
                    <label for="news-find-field">Find a news post</label>
                    <div class="news-find-field">
                        <input id="news-find-field" type="search" autocomplete="off" placeholder="Words from the title or summary">
                    </div>
                    <p class="news-find-result" role="status"></p>
                </form>
            )}
        </header>

        {page.data.length === 0
            ? <p>There’s no news yet.</p>
            : <ol class="news-list">
                {page.data.map((post) => (
                    <li>
                        <article class="news-item">
                            <h2><a href={baseUrl + "news/" + post.slug + "/"}>{post.title}</a></h2>
                            <p class="news-byline">By {post.author}, <time datetime={formatNewsDateValue(post.date)}>{formatNewsDate(post.date)}</time></p>
                            {/* The post's own Markdown from this repository, not dataset text. */}
                            {post.summary !== ""
                                ? <p class="news-excerpt">{post.summary}</p>
                                : <div class="news-excerpt" set:html={findFirstParagraph(post.html)} />}
                            <a class="news-more" href={baseUrl + "news/" + post.slug + "/"}>Read the post<span class="visually-hidden">: {post.title}</span></a>
                        </article>
                    </li>
                ))}
            </ol>}

        {page.lastPage > 1 && (
            <nav class="news-pages" aria-label="Pages of news">
                {page.url.prev ? <a href={page.url.prev} rel="prev">Newer posts</a> : <span />}
                <span class="news-page-count">Page {page.currentPage} of {page.lastPage}</span>
                {page.url.next ? <a href={page.url.next} rel="next">Older posts</a> : <span />}
            </nav>
        )}
    </div>
</BaseLayout>

<script>
    import type { NewsIndexEntry } from "../../data/news.ts";
    import type { SearchSuggestion } from "../../data/search-suggestions.ts";
    import type { PreparedSuggestion } from "../../data/suggestion-matching.ts";
    import { findSuggestions, prepareSuggestions } from "../../data/suggestion-matching.ts";
    import { connectNameCombobox } from "../../scripts/name-combobox.ts";

    // How many posts the find field lists.
    const findLimit = 8;

    const baseUrl = document.documentElement.dataset.baseUrl ?? "/";

    // Each post's date, by its page, for the notes beside the titles.
    const dateByPath = new Map<string, string>();

    let loadingPosts: Promise<Array<PreparedSuggestion>> | undefined;

    /**
     * Turn the posts into suggestions, found by the words of their summaries as well as their titles.
     *
     * @param entries - The posts, from news/posts.json.
     * @returns The posts, prepared for matching.
     */
    function createPostSuggestions(entries: Array<NewsIndexEntry>): Array<PreparedSuggestion>
    {
        const suggestions = new Array<SearchSuggestion>();

        for (const entry of entries)
        {
            dateByPath.set(entry.path, entry.date);
            suggestions.push({ name: entry.title, kind: "news", path: entry.path, synonymOf: "", authority: "", keywords: entry.summary });
        }

        return prepareSuggestions(suggestions);
    }

    /**
     * Load every post, once for the page.
     *
     * @returns The posts, prepared for matching.
     */
    async function loadPosts(): Promise<Array<PreparedSuggestion>>
    {
        loadingPosts ??= fetch(baseUrl + "news/posts.json")
            .then((response) => response.json() as Promise<Array<NewsIndexEntry>>)
            .then(createPostSuggestions);

        return await loadingPosts;
    }

    /**
     * Build the note below a post's title: its date.
     *
     * @param suggestion - The post.
     * @returns The note.
     */
    function createPostNote(suggestion: SearchSuggestion): HTMLElement
    {
        const note = document.createElement("span");

        note.textContent = dateByPath.get(suggestion.path) ?? "";

        return note;
    }

    /**
     * Open a post.
     *
     * @param suggestion - The chosen post.
     */
    function openPost(suggestion: SearchSuggestion): void
    {
        window.location.assign(baseUrl + suggestion.path);
    }

    /**
     * On Enter with no row highlighted, open the best match, or say there is none.
     *
     * @param event - The form's submission.
     */
    async function handleFindSubmit(event: SubmitEvent): Promise<void>
    {
        const input = document.querySelector<HTMLInputElement>("#news-find-field");
        const result = document.querySelector<HTMLElement>(".news-find-result");
        const query = input?.value.trim() ?? "";

        event.preventDefault();

        const best = findSuggestions(query, await loadPosts(), 1);

        if (best.length > 0)
        {
            openPost(best[0]);
        }
        else if (result)
        {
            result.textContent = query === "" ? "" : "No news post matches “" + query + "”.";
        }
    }

    /**
     * Turn on the find field.
     */
    function enableFind(): void
    {
        const form = document.querySelector<HTMLFormElement>(".news-find");
        const input = document.querySelector<HTMLInputElement>("#news-find-field");

        if (!form || !input)
        {
            return;
        }

        form.hidden = false;
        form.addEventListener("submit", (event) => void handleFindSubmit(event));
        connectNameCombobox(input, {
            listLabel: "Matching news posts",
            matchNames: { singular: "post", plural: "posts" },
            limit: findLimit,
            loadNames: loadPosts,
            createNote: createPostNote,
            chooseName: openPost,
            queryRow: undefined,
            notePlacement: "below",
        });
    }

    enableFind();
</script>

<style>
    .news-page
    {
        display: grid;
        grid-template-columns: minmax(0, var(--measure));
        gap: var(--space-7);
    }

    .news-header
    {
        display: grid;
        gap: var(--space-4);
    }

    h1
    {
        font-size: var(--text-display);
        font-weight: 800;
    }

    .news-summary
    {
        color: var(--color-muted);
    }

    .news-find
    {
        display: grid;
        gap: var(--space-2);
        font-family: var(--font-sans);
    }

    .news-find[hidden]
    {
        display: none;
    }

    .news-find label
    {
        font-weight: 600;
    }

    /* The list of matches opens below the field (name-combobox.ts; styled in BaseLayout). */
    .news-find-field
    {
        position: relative;
        max-width: 28rem;
    }

    .news-find input
    {
        width: 100%;
        padding: var(--space-2) var(--space-3);
        color: var(--color-ink);
        background: var(--color-surface);
        border: 1px solid color-mix(in srgb, var(--color-line) 40%, var(--color-muted));
        border-radius: var(--radius);
        font: inherit;
    }

    .news-find-result:empty
    {
        display: none;
    }

    .news-list
    {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .news-list > li
    {
        padding-block: var(--space-6);
        border-top: 1px solid var(--color-line);
    }

    .news-list > li:first-child
    {
        padding-top: 0;
        border-top: 0;
    }

    .news-item
    {
        display: grid;
        gap: var(--space-3);
    }

    h2 a
    {
        color: var(--color-ink);
        text-decoration: none;
    }

    h2 a:hover
    {
        color: var(--color-accent);
        text-decoration: underline;
    }

    .news-byline,
    .news-page-count
    {
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-small);
    }

    .news-excerpt :global(code)
    {
        font-family: var(--font-mono);
        font-size: 0.9em;
    }

    .news-more
    {
        justify-self: start;
        font-family: var(--font-sans);
        font-size: var(--text-small);
    }

    .news-pages
    {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: var(--space-4);
        padding-top: var(--space-5);
        border-top: 1px solid var(--color-line);
        font-family: var(--font-sans);
    }

    .news-pages a[rel="next"]
    {
        justify-self: end;
    }
</style>

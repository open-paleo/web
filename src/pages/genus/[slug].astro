---
import AgeFigure from "../../components/AgeFigure.astro";
import CorrectionLink from "../../components/CorrectionLink.astro";
import DiagnosisList from "../../components/DiagnosisList.astro";
import DisputeNote from "../../components/DisputeNote.astro";
import GenusMap from "../../components/GenusMap.astro";
import GlancePanel from "../../components/GlancePanel.astro";
import HowToCite from "../../components/HowToCite.astro";
import IcznCaseList from "../../components/IcznCaseList.astro";
import LineageTrail from "../../components/LineageTrail.astro";
import NotableSpecimenList from "../../components/NotableSpecimenList.astro";
import PageSection from "../../components/PageSection.astro";
import Prose from "../../components/Prose.astro";
import RecordMain from "../../components/RecordMain.astro";
import ReferenceList from "../../components/ReferenceList.astro";
import SpeciesSection from "../../components/SpeciesSection.astro";
import StatusBadge from "../../components/StatusBadge.astro";
import SynonymTable from "../../components/SynonymTable.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createRecordCitation } from "../../data/citations.ts";
import { formatAuthority, getFirstSentence } from "../../data/format.ts";
import { createGenusMap, getMapShapes, warnAboutMissingOutlines } from "../../data/genus-map.ts";
import { getTypeSpecies } from "../../data/records.ts";
import type { GenusEntry } from "../../data/site-data.ts";
import { getSiteData } from "../../data/site-data.ts";
import { createReferenceAnchor } from "../../data/urls.ts";

/**
 * Properties of a genus page.
 */
type Props = {
    /**
     * The genus the page describes.
     */
    entry: GenusEntry;
};

/**
 * One generated genus page: its URL parameter and its properties.
 */
type GenusPath = {
    /**
     * URL parameters: the genus slug.
     */
    params: GenusPathParameters;

    /**
     * Properties passed to the page.
     */
    props: Props;
};

/**
 * URL parameters of a genus page.
 */
type GenusPathParameters = {
    /**
     * The genus slug, as in genus/{slug}/.
     */
    slug: string;
};

/**
 * List one page per genus.
 *
 * @returns The path and properties of every genus page.
 */
export function getStaticPaths(): Array<GenusPath>
{
    const paths = new Array<GenusPath>();

    for (const entry of getSiteData().genera)
    {
        paths.push({ params: { slug: entry.slug }, props: { entry } });
    }

    return paths;
}

const { entry } = Astro.props;

// The page's address for its citation; local builds without SITE_URL cite the preview server's.
const citationUrl = new URL(Astro.url.pathname, Astro.site ?? "http://localhost:4321").href;
const genus = entry.record;
const siteData = getSiteData();
const typeSpecies = getTypeSpecies(genus);
const references = genus.references ?? [];
const genusMap = createGenusMap(genus, getMapShapes());

warnAboutMissingOutlines(genus, getMapShapes());
const authority = formatAuthority(genus.authors, genus.described, false);
const authorityReferenceId = genus.erected_in ?? typeSpecies.erected_in;
const authorityAnchor = "#" + createReferenceAnchor(siteData.referenceById.get(authorityReferenceId)?.slug ?? authorityReferenceId);
const pronunciation = genus.pronunciation;
const citation = createRecordCitation("Genus", genus.genus, entry.slug, citationUrl, getSiteData().metadata);
---

<BaseLayout title={genus.genus} description={getFirstSentence(genus.description)} section="genera">
    <article class="genus-page" data-pagefind-body data-pagefind-filter="kind:Genus">
        <LineageTrail taxonomy={genus.taxonomy} placement={genus.placement} />

        <header class="genus-header">
            <h1 class="genus-name taxon" data-pagefind-weight="10" style={"--name-length: " + genus.genus.length}>{genus.genus}</h1>
            <p class="genus-meta">
                {authority && <a class="authority" href={authorityAnchor}>{authority}</a>}
                {pronunciation?.phonetic && <span>{pronunciation.phonetic}</span>}
                {pronunciation?.ipa && <span>{pronunciation.ipa}</span>}
                <StatusBadge status={typeSpecies.status} />
            </p>
            {genus.etymology && <p class="etymology"><Prose text={genus.etymology.trim()} /></p>}
        </header>

        <div class="genus-age"><AgeFigure period={typeSpecies.period} /></div>

        <RecordMain>
            <GlancePanel genus={genus} />

            <p class="description"><Prose text={genus.description.trim()} /></p>

            {genus.dispute && (
                <PageSection title="Under dispute">
                    <DisputeNote dispute={genus.dispute} />
                </PageSection>
            )}

            {genusMap && (
                <PageSection title="Where it was found">
                    <GenusMap map={genusMap} genusName={genus.genus} />
                </PageSection>
            )}

            {genus.diagnostic_features && genus.diagnostic_features.length > 0 && (
                <PageSection title="Diagnosis">
                    <DiagnosisList features={genus.diagnostic_features} />
                </PageSection>
            )}

            <PageSection title={genus.species.length === 1 ? "Species" : "Species (" + genus.species.length + ")"}>
                <div class="species-grid">
                    {genus.species.map((species) => <SpeciesSection species={species} />)}
                </div>
            </PageSection>

            {genus.synonyms && genus.synonyms.length > 0 && (
                <PageSection title="Synonyms of the genus">
                    <SynonymTable synonyms={genus.synonyms} />
                </PageSection>
            )}

            {genus.notable_specimens && genus.notable_specimens.length > 0 && (
                <PageSection title="Notable specimens">
                    <NotableSpecimenList specimens={genus.notable_specimens} references={references} />
                </PageSection>
            )}

            {genus.iczn_cases && genus.iczn_cases.length > 0 && (
                <PageSection title="ICZN cases">
                    <IcznCaseList cases={genus.iczn_cases} references={references} />
                </PageSection>
            )}

            {references.length > 0 && (
                <PageSection title="References">
                    <ReferenceList references={references} />
                </PageSection>
            )}

            <PageSection title="Cite this record">
                <HowToCite citation={citation} subject={genus.genus} />
            </PageSection>

            <CorrectionLink kind="Genus" name={genus.genus} />
        </RecordMain>
    </article>
</BaseLayout>

<script>
    import "../../scripts/copy-buttons.ts";
</script>

<script>
    import "../../scripts/place-map.ts";
</script>

<style>
    .genus-page
    {
        display: grid;
        gap: var(--space-5);
    }

    /* The header is a size container, so the name below can be sized to its width, and its
       width comes from the page rather than from the name. */
    .genus-header
    {
        display: grid;
        gap: var(--space-3);
        container-type: inline-size;
    }

    .genus-age:empty
    {
        display: none;
    }

    /* A long name ("Micropachycephalosaurus") shrinks to fit the line on a phone rather than
       widening the page: at 800 weight a letter is under half an em wide, so a name of n
       letters fits at 1 / (n × 0.5) of the header's width. Should the estimate fall short (a
       fallback font before Alegreya loads), the name wraps rather than overflowing. */
    .genus-name
    {
        font-size: min(var(--text-display), 100cqi / (var(--name-length) * 0.5));
        overflow-wrap: anywhere;
        font-weight: 800;
        letter-spacing: -0.01em;
    }

    .genus-meta
    {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-1) var(--space-5);
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-interface);
    }

    .authority
    {
        color: var(--color-ink);
        text-decoration: none;
    }

    .authority:hover
    {
        color: var(--color-accent);
        text-decoration: underline;
    }

    /* The meaning of the name sits with the name. */
    .etymology
    {
        max-width: var(--measure);
        color: var(--color-muted);
    }

    .description
    {
        max-width: var(--measure);
    }

    /* Species boxes sit side by side where two fit, one per row otherwise. */
    .species-grid
    {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 28rem), 1fr));
        gap: var(--space-5);
        align-items: start;
    }

</style>

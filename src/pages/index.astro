---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout description="A community-maintained, version-controlled phylogenetic dataset for paleontology.">
    <section class="introduction">
        <h1>Open Paleo</h1>
        <p>
            A community-maintained phylogenetic dataset for paleontology, backed by published
            literature. The website is under construction; until it is ready, the dataset is
            available from the
            <a href="https://github.com/open-paleo/data">open-paleo/data repository</a>.
        </p>
    </section>
</BaseLayout>

<style>
    .introduction
    {
        display: grid;
        gap: var(--space-4);
        max-width: var(--measure);
    }

    h1
    {
        font-size: var(--text-display);
        font-weight: 800;
    }
</style>

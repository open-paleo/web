---
import GenusFilterForm from "../../components/GenusFilterForm.astro";
import GenusIndex from "../../components/GenusIndex.astro";
import TermLink from "../../components/TermLink.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatCount } from "../../data/format.ts";
import { createCladeIndexRows, getCladeFilterOptions } from "../../data/genus-index.ts";
import { getSiteData } from "../../data/site-data.ts";

const siteData = getSiteData();
const clades = [...siteData.clades].sort((first, second) => first.name.localeCompare(second.name, "en"));
const rows = createCladeIndexRows(clades, siteData, siteData.timeline);
const filterOptions = getCladeFilterOptions(rows, siteData.timeline);
const cladeCount = formatCount(rows.length, "clade", "clades");
---

<BaseLayout title="Clades" description={"All " + cladeCount + " in Open Paleo from A to Z, with the clade each is part of, how many genera it includes and when they lived."} navigationItem="clades">
    <div class="index-page">
        <header class="index-header">
            <h1>Clades</h1>
            <p class="index-summary">
                Here are all {cladeCount} in Open Paleo, from A to Z. Each entry shows who named the clade and when, the
                clade it’s part of, how many genera it includes, and the <TermLink term="epoch" text="epochs" /> those
                genera lived in. For how they all fit together, see the <a href={import.meta.env.BASE_URL + "tree/"}>Tree</a>.
            </p>
        </header>
        <GenusFilterForm options={filterOptions} total={rows.length} isCollapsible={false} itemNames={{ singular: "clade", plural: "clades" }} />
        <GenusIndex rows={rows} label="Clades" headingLevel={2} isFilterable={true} isGroupedByLetter={true} />
    </div>
</BaseLayout>

<script>
    import "../../scripts/genus-filters.ts";
</script>
<style>
    .index-page
    {
        display: grid;
        gap: var(--space-5);
    }

    .index-header
    {
        display: grid;
        gap: var(--space-4);
    }

    h1
    {
        font-size: var(--text-display);
        font-weight: 800;
    }

    .index-summary
    {
        color: var(--color-muted);
    }
</style>

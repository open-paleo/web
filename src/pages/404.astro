---
import BaseLayout from "../layouts/BaseLayout.astro";

const homeUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found" description="There’s no page at this address on Open Paleo.">
    {/* An address with capital letters may be a page's address in another case. This runs as the
       page is read, before the text below is drawn, and hides it while src/scripts/case-redirect.ts
       looks for the page; that script shows it again if there's no page. */}
    <script is:inline>
        if (/[A-Z]/.test(window.location.pathname))
        {
            document.documentElement.classList.add("is-finding-page");
        }
    </script>
    <div class="not-found">
        <h1>Page not found</h1>
        <p>There’s no page at this address. It may be mistyped, or the page may have moved after a genus or clade was renamed. Try one of these instead:</p>
        <ul>
            <li><a href={homeUrl + "search/"}>Search the dataset</a></li>
            <li><a href={homeUrl + "genera/"}>Browse all genera</a></li>
            <li><a href={homeUrl + "tree/"}>Explore the tree</a></li>
            <li><a href={homeUrl}>Go to the home page</a></li>
        </ul>
    </div>
</BaseLayout>

<script>
    import "../scripts/case-redirect.ts";
</script>

<style>
    :global(html.is-finding-page) .not-found
    {
        visibility: hidden;
    }

    .not-found
    {
        display: grid;
        gap: var(--space-5);
        max-width: var(--measure);
    }

    h1
    {
        font-size: var(--text-display);
        font-weight: 800;
    }

    ul
    {
        display: grid;
        gap: var(--space-2);
        margin: 0;
        padding-left: var(--space-5);
    }
</style>

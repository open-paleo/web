---
import BaseLayout from "../layouts/BaseLayout.astro";

const homeUrl = import.meta.env.BASE_URL;
---

<BaseLayout title="Page not found" description="There is no page at this address on Open Paleo.">
    <div class="not-found">
        <h1>Page not found</h1>
        <p>There is no page at this address. It may have been mistyped, or the record it pointed to may have been renamed.</p>
        <ul>
            <li><a href={homeUrl + "search/"}>Search the dataset</a></li>
            <li><a href={homeUrl + "genera/"}>Browse all genera</a></li>
            <li><a href={homeUrl + "tree/"}>Browse the tree of clades</a></li>
            <li><a href={homeUrl}>Go to the home page</a></li>
        </ul>
    </div>
</BaseLayout>

<style>
    .not-found
    {
        display: grid;
        gap: var(--space-5);
        max-width: var(--measure);
    }

    h1
    {
        font-size: var(--text-display);
        font-weight: 800;
    }

    ul
    {
        display: grid;
        gap: var(--space-2);
        margin: 0;
        padding-left: var(--space-5);
    }
</style>

---
import { externalServices, privacyContact, privacyPolicyEffectiveDate } from "../../data/privacy.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";

const contactUrl = "mailto:" + privacyContact;
---

<BaseLayout title="Privacy" description="How Open Paleo handles data about visits: what is counted, which services handle your requests, and your rights.">
    <article class="privacy-page">
        <header class="privacy-header">
            <h1>Privacy</h1>
            <p class="privacy-summary">
                Open Paleo counts visits to learn how the site is used. It sets no cookies and keeps nothing that
                identifies you.
            </p>
            <p class="privacy-effective">Effective {privacyPolicyEffectiveDate}</p>
        </header>

        <section>
            <h2>Who runs this site</h2>
            <p>
                Open Paleo is a volunteer project. The site is run by the project's maintainers, who are responsible
                for this policy. Write to
                <a href={contactUrl}>{privacyContact}</a> with any question or request about privacy.
            </p>
        </section>

        <section>
            <h2>What is collected, and why</h2>
            <p>
                The site counts visits, to learn which pages people read, which browsers and devices it needs to
                support, and how people find it. The counting is done by Plausible Analytics (see
                <a href="#services">services</a> below). For each page you open, Plausible receives data as described in
                <a href="https://plausible.io/data-policy">Plausible's data policy</a>.
            </p>
            <p>
                What Open Paleo sees are totals: how many people visited, which pages they read, which browsers and
                devices they used, and where visits came from. Nothing in them identifies you.
            </p>
            <p>
                Where data protection law, such as the European Union's General Data Protection Regulation, applies to
                this counting, its basis is Open Paleo's legitimate interest in understanding how the site is used. The
                counting is designed so that no visitor can be identified.
            </p>
        </section>

        <section>
            <h2>What isn't collected</h2>
            <ul>
                <li>The site has no accounts, sign-ins or forms.</li>
                <li>
                    It sets no cookies and stores nothing about you in your browser. The tree extractor keeps a copy of
                    its text-recognition data in your browser so it starts faster next time; that copy contains nothing
                    about you, and the figures you open are never uploaded.
                </li>
                <li>There is no advertising, and nothing tracks you across other sites.</li>
                <li>Open Paleo doesn't sell or share data about visitors.</li>
            </ul>
        </section>

        <section>
            <h2 id="services">Services that handle your requests</h2>
            <p>
                These services receive your requests, either because they host the site or because a page asks your
                browser to contact them. Refer to each service's privacy or data policy for more information on the
                information it collects.
            </p>
            {externalServices.map((service) => (
                <section class="service">
                    <h3>{service.name}</h3>
                    <dl>
                        <dt>Operator</dt>
                        <dd>{service.operator}</dd>
                        <dt>What it does</dt>
                        <dd>{service.role}</dd>
                        <dt>When</dt>
                        <dd>{service.whenContacted}</dd>
                        <dt>What it receives</dt>
                        <dd>{service.receives}</dd>
                        <dt>Its policy</dt>
                        <dd><a href={service.policyUrl}>{service.policyName}</a></dd>
                    </dl>
                </section>
            ))}
        </section>

        <section>
            <h2>How long data is kept</h2>
            <p>
                Open Paleo itself keeps only the visit totals in Plausible, for as long as the site uses Plausible;
                they are deleted with the Open Paleo account. Refer to each service's policy above for how long it
                keeps data.
            </p>
        </section>

        <section>
            <h2>Your rights</h2>
            <p>
                Depending on where you live, you may have the right to see, correct or delete personal data about you,
                or to object to its use. Because Open Paleo holds nothing that identifies you, there is usually nothing
                to find, but write to <a href={contactUrl}>{privacyContact}</a> and the maintainers will help, including
                with requests to the services above. You can also block the visit counting with your browser's privacy
                settings or an extension; the site works the same. If you are in the European Union or the United
                Kingdom, you have the right to file a complaint with their respective data protection authorities.
            </p>
        </section>

        <section>
            <h2>Children</h2>
            <p>
                The site is for a general audience. Nothing it collects identifies anyone, children included.
            </p>
        </section>

        <section>
            <h2>Links to other sites</h2>
            <p>
                "Suggest a correction" opens a form on GitHub, where you sign in under GitHub's terms, and references
                link to their publishers. Those sites' own policies apply there.
            </p>
        </section>

        <section>
            <h2>Changes to this policy</h2>
            <p>
                When the site changes how it handles data, this page changes with it, and its effective date moves.
                Every earlier version is in
                <a href="https://github.com/open-paleo/web/commits/main/src/data/privacy.ts">the site's history on GitHub</a>.
            </p>
        </section>
    </article>
</BaseLayout>

<style>
    .privacy-page
    {
        display: grid;
        gap: var(--space-6);
        max-width: var(--measure);
    }

    .privacy-header
    {
        display: grid;
        gap: var(--space-3);
    }

    h1
    {
        font-size: var(--text-display);
        font-weight: 800;
    }

    .privacy-summary
    {
        color: var(--color-muted);
    }

    .privacy-effective
    {
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-small);
    }

    section
    {
        display: grid;
        gap: var(--space-3);
    }

    ul
    {
        display: grid;
        gap: var(--space-2);
        margin: 0;
    }

    .service
    {
        gap: var(--space-2);
        padding-top: var(--space-3);
        border-top: 1px solid var(--color-line);
    }

    .service dl
    {
        display: grid;
        grid-template-columns: minmax(0, 9rem) minmax(0, 1fr);
        gap: var(--space-2) var(--space-4);
        margin: 0;
    }

    .service dt
    {
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-small);
    }

    .service dd
    {
        margin: 0;
    }

    @media (max-width: 30rem)
    {
        .service dl
        {
            grid-template-columns: minmax(0, 1fr);
            gap: var(--space-1);
        }

        .service dd + dt
        {
            margin-top: var(--space-2);
        }
    }
</style>

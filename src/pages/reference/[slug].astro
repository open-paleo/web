---
import Citation from "../../components/Citation.astro";
import CitingRecordList from "../../components/CitingRecordList.astro";
import CorrectionLink from "../../components/CorrectionLink.astro";
import FactList from "../../components/FactList.astro";
import NamedTaxonList from "../../components/NamedTaxonList.astro";
import PageSection from "../../components/PageSection.astro";
import Prose from "../../components/Prose.astro";
import RecordMain from "../../components/RecordMain.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createCitationParts, describeWorkKind, formatShortCitation } from "../../data/format.ts";
import type { Citation as CitationRecord, ReferenceEntry } from "../../data/site-data.ts";
import { getSiteData } from "../../data/site-data.ts";

/**
 * Properties of a reference page.
 */
type Props = {
    /**
     * The cited work the page describes.
     */
    entry: ReferenceEntry;
};

/**
 * One generated reference page: its URL parameter and its properties.
 */
type ReferencePath = {
    /**
     * URL parameters: the reference slug.
     */
    params: ReferencePathParameters;

    /**
     * Properties passed to the page.
     */
    props: Props;
};

/**
 * URL parameters of a reference page.
 */
type ReferencePathParameters = {
    /**
     * The reference slug, as in reference/{slug}/.
     */
    slug: string;
};

/**
 * List one page per cited work.
 *
 * @returns The path and properties of every reference page.
 */
export function getStaticPaths(): Array<ReferencePath>
{
    const paths = new Array<ReferencePath>();

    for (const entry of getSiteData().references)
    {
        paths.push({ params: { slug: entry.slug }, props: { entry } });
    }

    return paths;
}

const { entry } = Astro.props;
const reference = entry.reference;
const parts = createCitationParts(reference);
const shortCitation = formatShortCitation(reference);
const workKind = describeWorkKind(reference);
const genusCitations = new Array<CitationRecord>();
const cladeCitations = new Array<CitationRecord>();

for (const citation of entry.citations)
{
    if (citation.kind === "genus")
    {
        genusCitations.push(citation);
    }
    else
    {
        cladeCitations.push(citation);
    }
}

const citingCount = entry.citations.length;
const pageDescription = shortCitation + ". " + (parts.title ? parts.title + ". " : "") + "Cited by " + citingCount +
    (citingCount === 1 ? " record" : " records") + " in Open Paleo.";
---

<BaseLayout title={shortCitation} description={pageDescription} section="references">
    <article class="reference-page" data-pagefind-body data-pagefind-filter="kind:Reference">
        <header class="reference-header">
            {workKind && <p class="work-kind">{workKind}</p>}
            <h1 class="work-title">{parts.title ? <Prose text={parts.title} /> : entry.id}</h1>
            <p class="work-authors">{parts.authors} ({parts.year})</p>
        </header>

        <RecordMain>
            <FactList label="About this work">
                {workKind && (
                    <>
                        <dt>Kind</dt>
                        <dd>{workKind}</dd>
                    </>
                )}
                <dt>Year</dt>
                <dd class="figures">{parts.year}</dd>
                {parts.container && (
                    <>
                        <dt>{reference.journal ? "Journal" : reference.book ? "In" : "Series"}</dt>
                        <dd><i>{parts.container}</i></dd>
                    </>
                )}
                {parts.doi && (
                    <>
                        <dt>DOI</dt>
                        <dd class="break-anywhere"><a href={"https://doi.org/" + parts.doi}>{parts.doi}</a></dd>
                    </>
                )}
                {reference.isbn && (
                    <>
                        <dt>ISBN</dt>
                        <dd class="figures">{reference.isbn}</dd>
                    </>
                )}
                <dt>Cited by</dt>
                <dd class="figures">{citingCount === 1 ? "1 record" : citingCount + " records"}</dd>
                <dt>Key</dt>
                <dd class="break-anywhere">{entry.id}</dd>
            </FactList>

            <PageSection title="Citation">
                <p class="full-citation"><Citation reference={reference} /></p>
            </PageSection>

            {entry.namedTaxa.length > 0 && (
                <PageSection title="Names first published here">
                    <NamedTaxonList taxa={entry.namedTaxa} />
                </PageSection>
            )}

            {genusCitations.length > 0 && (
                <PageSection title="Cited by genera">
                    <CitingRecordList citations={genusCitations} referenceSlug={entry.slug} />
                </PageSection>
            )}

            {cladeCitations.length > 0 && (
                <PageSection title="Cited by clades">
                    <CitingRecordList citations={cladeCitations} referenceSlug={entry.slug} />
                </PageSection>
            )}

            <CorrectionLink kind="Reference" name={entry.id + ", " + shortCitation} />
        </RecordMain>
    </article>
</BaseLayout>

<style>
    .reference-page
    {
        display: grid;
        gap: var(--space-6);
    }

    .reference-header
    {
        display: grid;
        gap: var(--space-2);
        max-width: 52rem;
    }

    .work-kind,
    .work-authors
    {
        color: var(--color-muted);
        font-family: var(--font-sans);
    }

    .work-title
    {
        font-size: var(--text-heading-1);
        line-height: 1.25;
    }

    .full-citation
    {
        max-width: var(--measure);
        padding: var(--space-4) var(--space-5);
        background: var(--color-surface);
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
    }

    .break-anywhere
    {
        overflow-wrap: anywhere;
    }
</style>

---
import HeadingLink from "../../components/HeadingLink.astro";
import LicenseList from "../../components/LicenseList.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { createLicenseEntries } from "../../data/licenses.ts";

const rootDirectory = process.cwd();
const codeEntries = createLicenseEntries("code", rootDirectory);
const logoEntries = createLicenseEntries("logos", rootDirectory);
const fontEntries = createLicenseEntries("fonts", rootDirectory);
const dataEntries = createLicenseEntries("data", rootDirectory);
---

<BaseLayout title="Licenses" description="The software, models, logos, fonts, data and maps by others that Open Paleo uses, and the licenses we use them under.">
    <article class="licenses-page">
        <header class="licenses-header">
            <h1>Licenses</h1>
            <p class="licenses-summary">
                Open Paleo’s own code is licensed under the
                <a href="https://github.com/open-paleo/web/blob/main/LICENSE">MIT License</a>, except the outline tracer,
                which includes potrace and so is under the GPL. The Open Paleo data is licensed under CC BY 4.0. Below is
                the work of others that we use, with each license. You’ll find the same license texts in a LICENSE.txt
                file in every folder of bundled files on the site.
            </p>
        </header>

        <section>
            <h2 id="section-software-and-models">Software and models<HeadingLink id="section-software-and-models" label="Software and models" /></h2>
            <LicenseList entries={codeEntries} />
        </section>

        <section>
            <h2 id="section-logos">Logos<HeadingLink id="section-logos" label="Logos" /></h2>
            <LicenseList entries={logoEntries} />
        </section>

        <section>
            <h2 id="section-fonts">Fonts<HeadingLink id="section-fonts" label="Fonts" /></h2>
            <LicenseList entries={fontEntries} />
        </section>

        <section>
            <h2 id="section-data-and-maps">Data and maps<HeadingLink id="section-data-and-maps" label="Data and maps" /></h2>
            <LicenseList entries={dataEntries} />
        </section>
    </article>
</BaseLayout>

<style>
    .licenses-page
    {
        display: grid;
        gap: var(--space-6);
        max-width: var(--measure);
    }

    .licenses-header
    {
        display: grid;
        gap: var(--space-3);
    }

    h1
    {
        font-size: var(--text-display);
        font-weight: 800;
    }

    .licenses-summary
    {
        color: var(--color-muted);
    }

    section
    {
        display: grid;
        gap: var(--space-3);
    }
</style>

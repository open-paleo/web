---
import type { Species } from "../data/dataset.ts";
import { formatAuthority } from "../data/format.ts";
import { getSiteData } from "../data/site-data.ts";
import { createSlug } from "../data/slugs.ts";
import { createReferenceAnchor } from "../data/urls.ts";
import Prose from "./Prose.astro";
import SpeciesFacts from "./SpeciesFacts.astro";
import StatusBadge from "./StatusBadge.astro";
import SynonymList from "./SynonymList.astro";

/**
 * Properties of the box describing one species of a genus.
 */
type Props = {
    /**
     * The species record.
     */
    species: Species;
};

const { species } = Astro.props;
const siteData = getSiteData();
const authority = formatAuthority(species.authors, species.described, species.erected_as !== undefined);
const authorityAnchor = "#" + createReferenceAnchor(siteData.referenceById.get(species.erected_in)?.slug ?? species.erected_in);
const headingId = createSlug(species.name);
---

<section class="species-box" aria-labelledby={headingId}>
    <header class="species-header">
        <h3 id={headingId}>
            <i class="taxon">{species.name}</i>
            {authority && <a class="authority" href={authorityAnchor}>{authority}</a>}
            <StatusBadge status={species.status} />
        </h3>
        {species.type_species && <p class="species-role">Type species</p>}
        {species.erected_as && <p class="species-role">First named as <i class="taxon">{species.erected_as}</i></p>}
    </header>
    {species.etymology && <p class="species-etymology"><Prose text={species.etymology.trim()} /></p>}
    {species.description && <p><Prose text={species.description.trim()} /></p>}
    <SpeciesFacts species={species} />
    {species.synonyms && species.synonyms.length > 0 && (
        <div class="species-synonyms">
            <h4>Synonyms</h4>
            <SynonymList synonyms={species.synonyms} />
        </div>
    )}
</section>

<style>
    /* Each species is a box holding everything recorded for it, so a genus with several species
       reads as a set of comparable boxes. */
    .species-box
    {
        display: grid;
        gap: var(--space-4);
        align-content: start;
        min-width: 0;
        padding: var(--space-5);
        background: var(--color-surface);
        border: 1px solid color-mix(in srgb, var(--color-line) 55%, var(--color-muted));
        border-radius: var(--radius);
    }

    .species-header
    {
        display: grid;
        gap: var(--space-1);
    }

    h3
    {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-1) var(--space-3);
    }

    .authority
    {
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-interface);
        font-weight: 400;
        text-decoration: none;
    }

    .authority:hover
    {
        color: var(--color-accent);
        text-decoration: underline;
    }

    .species-role
    {
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-small);
    }

    .species-etymology
    {
        color: var(--color-muted);
    }

    .species-synonyms
    {
        display: grid;
        gap: var(--space-2);
        min-width: 0;
    }

    @media (max-width: 30rem)
    {
        .species-box
        {
            padding: var(--space-4);
        }
    }
</style>

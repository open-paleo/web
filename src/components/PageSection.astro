---
import { createSlug } from "../data/slugs.ts";

/**
 * Properties of a major section of a record page: a rule, a heading, and the content.
 */
type Props = {
    /**
     * The section heading.
     */
    title: string;
};

const { title } = Astro.props;
const headingId = "section-" + createSlug(title);
---

<section class="page-section" aria-labelledby={headingId}>
    <h2 id={headingId}>{title}</h2>
    <slot />
</section>

<style>
    /* Each heading is underlined by a rule in the text color that spans the content column.
       Prose inside keeps to the reading measure on its own. The space between sections does
       the separating; the rule ties each heading to what follows it. */
    .page-section
    {
        display: grid;
        gap: var(--space-5);
        min-width: 0;
    }

    h2
    {
        padding-bottom: var(--space-2);
        border-bottom: 1px solid var(--color-ink);
        font-size: var(--text-heading-2);
    }
</style>

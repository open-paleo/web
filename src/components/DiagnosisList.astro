---
import Prose from "./Prose.astro";

/**
 * Properties of a numbered list of diagnostic features.
 */
type Props = {
    /**
     * The features, in the order the dataset gives them.
     */
    features: Array<string>;
};

const { features } = Astro.props;
---

<ol class="diagnosis-list">
    {features.map((feature) => <li><Prose text={feature.trim()} /></li>)}
</ol>

<style>
    .diagnosis-list
    {
        display: grid;
        gap: var(--space-2);
        max-width: var(--measure);
        margin: 0;
        padding-left: var(--space-5);
    }

    li::marker
    {
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-small);
    }
</style>

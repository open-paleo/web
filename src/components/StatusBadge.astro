---
import type { Status } from "../data/dataset.ts";
import { capitalizeFirstLetter } from "../data/format.ts";

/**
 * Properties of a species status badge.
 */
type Props = {
    /**
     * The species status. Valid names get no badge.
     */
    status: Status;
};

const { status } = Astro.props;
---

{status !== "valid" && (
    <span class:list={["status-badge", status === "disputed" ? "status-disputed" : "status-doubtful"]}>
        {capitalizeFirstLetter(status)}
    </span>
)}

<style>
    .status-badge
    {
        display: inline-block;
        padding: 0 var(--space-2);
        border-radius: var(--radius-small);
        font-family: var(--font-sans);
        font-size: var(--text-caption);
        font-style: normal;
        font-weight: 500;
        line-height: 1.6;
        white-space: nowrap;
        vertical-align: middle;
    }

    .status-disputed
    {
        color: var(--color-caution);
        background: var(--color-caution-soft);
        border: 1px solid var(--color-caution);
    }

    .status-doubtful
    {
        color: var(--color-muted);
        border: 1px dashed var(--color-muted);
    }
</style>

---
import type { Status } from "../data/dataset.ts";
import GlossaryTerm from "./GlossaryTerm.astro";
import { capitalizeFirstLetter } from "../data/format.ts";
import { findGlossaryEntry, getGlossary } from "../data/glossary.ts";

/**
 * Properties of a species status badge.
 */
type Props = {
    /**
     * The species status. Valid names get no badge.
     */
    status: Status;

    /**
     * Whether the status links to its glossary entry. Leave it off inside another link.
     */
    linkToGlossary?: boolean;
};

const { status, linkToGlossary = false } = Astro.props;
const label = capitalizeFirstLetter(status);
const term = linkToGlossary ? findGlossaryEntry(getGlossary(), status) : undefined;
---

{status !== "valid" && (
    <span class:list={["status-badge", status === "disputed" ? "status-disputed" : "status-doubtful"]}>
        {term ? <GlossaryTerm entry={term} text={label} /> : label}
    </span>
)}

<style>
    .status-badge
    {
        display: inline-block;
        padding: 0 var(--space-2);
        border-radius: var(--radius-small);
        font-family: var(--font-sans);
        font-size: var(--text-caption);
        font-style: normal;
        font-weight: 500;
        line-height: 1.6;
        white-space: nowrap;
        vertical-align: middle;
    }

    .status-disputed
    {
        color: var(--color-caution);
        background: var(--color-caution-soft);
        border: 1px solid var(--color-caution);
    }

    .status-doubtful
    {
        color: var(--color-muted);
        border: 1px dashed var(--color-muted);
    }
</style>

---
import type { Dispute } from "../data/dataset.ts";
import Prose from "./Prose.astro";

/**
 * Properties of the note that summarizes a live scientific dispute about a record. Place it in
 * a section headed "Under dispute".
 */
type Props = {
    /**
     * The record's dispute block.
     */
    dispute: Dispute;
};

const { dispute } = Astro.props;
---

<div class="dispute-note">
    <p><Prose text={dispute.summary.trim()} /></p>
</div>

<style>
    /* A tinted panel with a caution border. The section heading above it says what it is, so
       the panel itself stays quiet. */
    .dispute-note
    {
        max-width: var(--measure);
        padding: var(--space-4) var(--space-5);
        background: color-mix(in srgb, var(--color-caution-soft) 55%, var(--color-background));
        border: 1px solid color-mix(in srgb, var(--color-caution) 45%, var(--color-background));
        border-radius: var(--radius);
    }
</style>

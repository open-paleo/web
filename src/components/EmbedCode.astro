---
import { embedFrameHeight, embedFrameSectionId, embedFrameWidth } from "../data/embed.ts";

/**
 * Properties of the code other sites use to show a genus's infobox, with a button that copies
 * it and the infobox itself beside it as a preview.
 */
type Props = {
    /**
     * The `iframe` element that shows the infobox.
     */
    embedCode: string;

    /**
     * The infobox's path.
     */
    embedPath: string;

    /**
     * The genus name.
     */
    genusName: string;
};

const { embedCode, embedPath, genusName } = Astro.props;
// The Developers page's part on fitting the frame, by its fixed id.
const documentationPath = import.meta.env.BASE_URL + "developers/#" + embedFrameSectionId;
---

{/* The copy button is hidden until src/scripts/copy-buttons.ts shows it, since it needs it;
   without JavaScript the code can still be selected and copied. */}
<div class="embed-code" data-pagefind-ignore>
    <div class="embed-instructions">
        <p>
            Want to show information about <i class="taxon">{genusName}</i> on your own website? Add the code below to
            your site to show <a href={embedPath}>an infobox</a>. The box is {embedFrameWidth} × {embedFrameHeight}
            pixels, so a longer infobox scrolls inside the frame. To resize the frame to fit once it has loaded, see the
            <a href={documentationPath}>developer documentation</a>.
        </p>
        <pre class="code-block" tabindex="0" role="region" aria-label={"Embed code for " + genusName}><code>{embedCode}</code></pre>
        <p class="copy-actions" hidden>
            <button class="copy-button" type="button" data-copy-text={embedCode} data-copied-message="Embed code copied.">Copy embed code</button>
            <span class="copy-status" role="status"></span>
        </p>
    </div>
    {/* The infobox as the embed code shows it, at the same size. */}
    <iframe
        class="embed-preview"
        src={embedPath}
        title={"Preview of the " + genusName + " infobox"}
        width={embedFrameWidth}
        height={embedFrameHeight}
        loading="lazy"></iframe>
</div>

<style>
    /* The instructions and code beside the preview; on narrow screens the preview goes below. */
    .embed-code
    {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: var(--space-5) var(--space-7);
        align-items: start;
    }

    /* One column that may shrink below the code's line, which scrolls inside its box instead. */
    .embed-instructions
    {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-3);
        max-width: var(--measure);
    }

    .embed-preview
    {
        max-width: 100%;
        border: 0;
    }

    @media (max-width: 52rem)
    {
        .embed-code
        {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    /* Code is the one place a monospace face is used. */
    .code-block
    {
        margin: 0;
        padding: var(--space-4) var(--space-5);
        overflow-x: auto;
        background: var(--color-surface);
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
        font-family: var(--font-mono);
        font-size: var(--text-small);
    }

    .copy-actions
    {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-2) var(--space-3);
        font-family: var(--font-sans);
    }

    .copy-actions[hidden]
    {
        display: none;
    }

    .copy-button
    {
        padding: var(--space-1) var(--space-4);
        color: var(--color-accent);
        background: var(--color-surface);
        border: 1px solid var(--color-accent);
        border-radius: var(--radius);
        font-size: var(--text-interface);
        cursor: pointer;
    }

    .copy-status
    {
        color: var(--color-muted);
        font-size: var(--text-small);
    }
</style>

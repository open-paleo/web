---
import type { AgeMarker, AgeRow } from "../data/age-figure.ts";
import { createAgeFigureModel } from "../data/age-figure.ts";
import type { Period } from "../data/dataset.ts";
import { formatAgeRange } from "../data/format.ts";
import { getTimePages, listAgeCaptionParts } from "../data/time-pages.ts";
import { createPagePath } from "../data/urls.ts";
import { getSiteData } from "../data/site-data.ts";

/**
 * Properties of the age figure: where a record sits in geologic time.
 */
type Props = {
    /**
     * The record's period block, with its stages and numeric age range.
     */
    period: Period;

    /**
     * Text placed before the age range in the caption, such as "Its genera lived". The range
     * reads on its own when this is left out.
     */
    rangeIntroduction?: string;
};

const { period, rangeIntroduction } = Astro.props;
const timeline = getSiteData().timeline;
const model = timeline ? createAgeFigureModel(period, timeline) : undefined;
const ageRange = period.from_ma !== undefined && period.to_ma !== undefined ? formatAgeRange(period.from_ma, period.to_ma) : "";
// The stage and epoch names link to their stage and period pages, where those exist.
const captionParts = listAgeCaptionParts(period, getTimePages());
const baseUrl = import.meta.env.BASE_URL;

/**
 * Bands narrower than this share of the row carry no label; their name shows on hover.
 */
const labelledBandPercent = 9;

/**
 * Bands narrower than this share of the row also hide their name when the row is narrow, as on
 * a phone.
 */
const labelledBandPercentWhenNarrow = 20;
/**
 * Create the marker's position and width. A marker that starts on a band boundary moves one
 * pixel right, past the separator each band draws on its first pixel.
 *
 * @param marker - The marker's geometry.
 * @returns The inline style.
 */
function createMarkerStyle(marker: AgeMarker): string
{
    if (marker.startsAtBandBoundary)
    {
        return "left: calc(" + marker.leftPercent + "% + 1px); width: calc(" + marker.widthPercent + "% - 1px)";
    }

    return "left: " + marker.leftPercent + "%; width: " + marker.widthPercent + "%";
}

const rows = new Array<AgeRow>();

if (model)
{
    rows.push(model.periodRow);

    if (model.stageRow)
    {
        rows.push(model.stageRow);
    }
}
---

{model && (
    <figure class="age-figure">
        <figcaption class="age-caption">
            <span class="age-range figures">{rangeIntroduction && <span class="age-introduction">{rangeIntroduction} </span>}{ageRange}</span>
            <span class="age-context">{captionParts.map((part) => part.section ? <a href={createPagePath(baseUrl, part.section, part.slug)}>{part.text}</a> : part.text)}</span>
        </figcaption>
        {rows.map((row, rowIndex) => (
            <div class="age-row-group">
                {rowIndex > 0 && <div class="age-row-label" data-pagefind-ignore>{row.label}</div>}
                {/* The marker sits behind the bands and reaches past them, so the range shows as tabs
                   above and below the row and never crosses a band's label. */}
                <div class="age-track" aria-hidden="true" data-pagefind-ignore>
                    <span class="age-marker" style={createMarkerStyle(row.marker)}></span>
                    <div class="age-row">
                        {row.bands.map((band) => (
                            <span
                                class:list={[
                                    "age-band",
                                    {
                                        "has-dark-color": band.hasDarkColor,
                                        "is-in-range": band.isInRange,
                                        "is-small": band.widthPercent < labelledBandPercentWhenNarrow,
                                    },
                                ]}
                                style={"flex-basis: " + band.widthPercent + "%; background: var(" + band.colorToken + ")"}
                                title={band.name}
                            >{band.widthPercent >= labelledBandPercent && <span class="age-band-label">{band.name}</span>}</span>
                        ))}
                    </div>
                </div>
                <div class="age-scale figures" aria-hidden="true" data-pagefind-ignore>
                    <span>{row.fromMa.toFixed(1)} Ma</span>
                    <span>{row.toMa.toFixed(1)} Ma</span>
                </div>
            </div>
        ))}
    </figure>
)}

<style>
    .age-figure
    {
        display: grid;
        gap: var(--space-2);
        margin: 0;
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-line);
        font-family: var(--font-sans);
        font-size: var(--text-caption);
    }

    .age-caption
    {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-1) var(--space-4);
        font-size: var(--text-interface);
    }

    .age-range
    {
        font-weight: 700;
    }

    .age-introduction
    {
        font-weight: 400;
    }

    .age-context,
    .age-row-label,
    .age-scale
    {
        color: var(--color-muted);
    }

    /* The column may shrink below the width of the stage names, so the figure fits a 320px
       window; band labels that no longer fit end in an ellipsis. */
    .age-row-group
    {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-1);
        container-type: inline-size;
    }

    .age-row-label
    {
        padding-top: var(--space-2);
    }

    .age-row
    {
        position: relative;
        display: flex;
        height: 2.1rem;
        overflow: hidden;
        border-radius: var(--radius-small);
    }

    .age-band
    {
        display: flex;
        flex-grow: 0;
        flex-shrink: 0;
        align-items: center;
        min-width: 0;
        padding-inline: var(--space-2);
        overflow: hidden;
        color: var(--color-on-period);
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .age-band + .age-band
    {
        box-shadow: inset 1px 0 0 var(--color-surface);
    }

    /* Bands the record's range falls in have bold labels, so the range reads in the text as well
       as in the tabs. */
    .age-band.is-in-range
    {
        font-weight: 700;
    }

    .age-band.has-dark-color
    {
        color: var(--color-on-period-dark);
    }

    .age-band-label
    {
        overflow: hidden;
        text-overflow: ellipsis;
    }

    @container (max-width: 36rem)
    {
        .age-band.is-small .age-band-label
        {
            visibility: hidden;
        }
    }

    /* The track holds the marker behind the row of bands. Its padding is how far the marker
       reaches past the bands: the tabs above and below that show the record's range. */
    .age-track
    {
        position: relative;
        padding-block: 6px;
    }

    .age-marker
    {
        position: absolute;
        top: 0;
        bottom: 0;
        min-width: 6px;
        background: var(--color-ink);
        border-radius: var(--radius-small);
    }

    .age-scale
    {
        display: flex;
        justify-content: space-between;
    }
</style>

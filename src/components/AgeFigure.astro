---
import type { AgeBand as AgeBandData, AgeBandDetails, AgeMarker, AgeRow } from "../data/age-figure.ts";
import { createAgeFigureModel } from "../data/age-figure.ts";
import AgeBand from "./AgeBand.astro";
import type { Period } from "../data/dataset.ts";
import { formatAgeRange, formatGenusCount } from "../data/format.ts";
import { getTimePages, getAgeCaptionParts } from "../data/time-pages.ts";
import { createPagePath } from "../data/urls.ts";
import { getSiteData } from "../data/site-data.ts";

/**
 * Properties of the age figure: where a record sits in geologic time.
 */
type Props = {
    /**
     * The record's period block, with its stages and numeric age range.
     */
    period: Period;

    /**
     * Text placed before the age range in the caption, such as "Its genera lived". The range
     * reads on its own when this is left out.
     */
    rangeIntroduction?: string;

    /**
     * A sentence qualifying the age, shown under the caption: on a genus page, why its type
     * species' age is that of its rock unit, or of older rocks. Left out, no note is shown.
     */
    note?: string;
};

const { period, rangeIntroduction, note } = Astro.props;
const timeline = getSiteData().timeline;
const model = timeline ? createAgeFigureModel(period, timeline) : undefined;
const ageRange = period.from_ma !== undefined && period.to_ma !== undefined ? formatAgeRange(period.from_ma, period.to_ma) : "";
// The stage and epoch names link to their stage and period pages, where those exist.
const captionParts = getAgeCaptionParts(period, getTimePages());
const baseUrl = import.meta.env.BASE_URL;

/**
 * Create the marker's position and width. A marker that starts on a band boundary moves one
 * pixel right, past the separator each band draws on its first pixel.
 *
 * @param marker - The marker's geometry.
 * @returns The inline style.
 */
function createMarkerStyle(marker: AgeMarker): string
{
    if (marker.startsAtBandBoundary)
    {
        return "left: calc(" + marker.leftPercent + "% + 1px); width: calc(" + marker.widthPercent + "% - 1px)";
    }

    return "left: " + marker.leftPercent + "%; width: " + marker.widthPercent + "%";
}

const timePages = getTimePages();
const currentPath = Astro.url.pathname;
const epochByStage = new Map<string, string>();

for (const epoch of timeline?.epochs ?? [])
{
    for (const stage of epoch.stages)
    {
        epochByStage.set(stage.name, epoch.name);
    }
}

/**
 * Describe a band for its tooltip and link.
 *
 * @param band - The band.
 * @param isStage - Whether the band is a stage rather than a period.
 * @param centerPercent - Where the band's middle is across the row.
 * @returns The details.
 */
function describeBand(band: AgeBandData, isStage: boolean, centerPercent: number): AgeBandDetails
{
    const page = isStage ? timePages.stageByName.get(band.name) : timePages.periodByName.get(band.name);
    const path = page ? createPagePath(baseUrl, isStage ? "stage" : "period", page.slug) : "";

    return {
        band,
        href: path === currentPath ? "" : path,
        kind: isStage ? "Stage of the " + (epochByStage.get(band.name) ?? "") : "Period",
        age: formatAgeRange(band.fromMa, band.toMa),
        genera: page ? formatGenusCount(page.genera.length) : "No genera in Open Paleo yet",
        alignment: centerPercent < 15 ? "start" : centerPercent > 85 ? "end" : "center",
    };
}

/**
 * Describe each band of a row.
 *
 * @param row - The row.
 * @param isStageRow - Whether the row holds stages.
 * @returns The details of each band, in order.
 */
function describeBands(row: AgeRow, isStageRow: boolean): Array<AgeBandDetails>
{
    const details = new Array<AgeBandDetails>();
    let leftPercent = 0;

    for (const band of row.bands)
    {
        details.push(describeBand(band, isStageRow, leftPercent + band.widthPercent / 2));
        leftPercent += band.widthPercent;
    }

    return details;
}

const rows = new Array<AgeRow>();

if (model)
{
    rows.push(model.periodRow);

    if (model.stageRow)
    {
        rows.push(model.stageRow);
    }
}
---

{model && (
    <figure class="age-figure">
        <figcaption class="age-caption">
            <span class="age-range figures">{rangeIntroduction && <span class="age-introduction">{rangeIntroduction} </span>}{ageRange}</span>
            <span class="age-context">{captionParts.map((part) => part.section ? <a href={createPagePath(baseUrl, part.section, part.slug)}>{part.text}</a> : part.text)}</span>
            {note && <span class="age-note">{note}</span>}
        </figcaption>
        {rows.map((row, rowIndex) => (
            <div class="age-row-group">
                {rowIndex > 0 && <div class="age-row-label" data-pagefind-ignore>{row.label}</div>}
                {/* The marker sits behind the bands and reaches past them, so the range shows as tabs
                   above and below the row and never crosses a band's label. */}
                {/* The marker is hidden from screen readers; AgeBand.astro describes the bands. */}
                <div class="age-track" data-pagefind-ignore>
                    <span class="age-marker" style={createMarkerStyle(row.marker)} aria-hidden="true"></span>
                    <div class="age-row">
                        {describeBands(row, rowIndex > 0).map((details) => <AgeBand details={details} />)}
                    </div>
                </div>
                <div class="age-scale figures" aria-hidden="true" data-pagefind-ignore>
                    <span>{row.fromMa.toFixed(1)} Ma</span>
                    <span>{row.toMa.toFixed(1)} Ma</span>
                </div>
            </div>
        ))}
    </figure>
)}

<style>
    .age-figure
    {
        display: grid;
        gap: var(--space-2);
        margin: 0;
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-line);
        font-family: var(--font-sans);
        font-size: var(--text-caption);
    }

    .age-caption
    {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-1) var(--space-4);
        font-size: var(--text-interface);
    }

    .age-range
    {
        font-weight: 700;
    }

    .age-introduction
    {
        font-weight: 400;
    }

    .age-context,
    .age-row-label,
    .age-scale
    {
        color: var(--color-muted);
    }

    /* On a line of its own below the range and its stages, at the reading measure. */
    .age-note
    {
        flex-basis: 100%;
        max-width: var(--measure);
        color: var(--color-muted);
        font-size: var(--text-caption);
    }

    /* The column may shrink below the width of the stage names, so the figure fits a 320px
       window; band labels that no longer fit end in an ellipsis. */
    .age-row-group
    {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--space-1);
        container-type: inline-size;
    }

    .age-row-label
    {
        padding-top: var(--space-2);
    }

    .age-row
    {
        position: relative;
        display: flex;
        height: 2.1rem;
    }

    /* The track holds the marker behind the row of bands. Its padding is how far the marker
       reaches past the bands: the tabs above and below that show the record's range. */
    .age-track
    {
        position: relative;
        padding-block: 6px;
    }

    .age-marker
    {
        position: absolute;
        top: 0;
        bottom: 0;
        min-width: 6px;
        background: var(--color-ink);
        border-radius: var(--radius-small);
    }

    .age-scale
    {
        display: flex;
        justify-content: space-between;
    }
</style>

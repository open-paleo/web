---
import type { OutlineEntry } from "../data/media.ts";
import { getLicenseInfo } from "../data/media.ts";

/**
 * Properties of the outline a genus or clade page shows beside its name, and its credit line.
 * The page's header places them, in the grid areas "outline" and "credit".
 */
type Props = {
    /**
     * The outline.
     */
    outline: OutlineEntry;
};

const { outline } = Astro.props;
const record = outline.record;
const license = getLicenseInfo(record.license);
// "Recolored; flipped horizontally" becomes "recolored and flipped horizontally".
const changes = record.changes.toLowerCase().replace("; ", " and ");

// The outline is decorative; the credit line describes it. open-paleo/media's build checks and
// cleans every SVG, so it is inlined unchanged.
---
<div class="taxon-outline" aria-hidden="true"><Fragment set:html={outline.svg} /></div>
<p class="taxon-outline-credit">{record.title}, based on <i class="taxon">{record.depicts}</i>. By <a href={record.source}>{record.creator}</a>, {license.url ? <a href={license.url}>{license.name}</a> : license.name}, {changes}.</p>

<style>
    .taxon-outline
    {
        grid-area: outline;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        color: var(--color-muted);
    }

    .taxon-outline :global(svg)
    {
        width: 100%;
        max-height: 7rem;
    }

    .taxon-outline-credit
    {
        grid-area: credit;
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-caption);
    }

    .taxon-outline-credit a
    {
        color: inherit;
    }
</style>

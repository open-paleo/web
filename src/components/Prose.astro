---
import GlossaryTerm from "./GlossaryTerm.astro";
import { bindAbbreviatedGenus, formatQuotes } from "../data/format.ts";
import type { GlossaryEntry } from "../data/glossary.ts";
import { getGlossary, splitGlossaryTerms } from "../data/glossary.ts";
import { findTaxonPath, getProseLinks, splitNamedLinks } from "../data/prose-links.ts";
import { getSiteData } from "../data/site-data.ts";

/**
 * Properties of a run of prose from the dataset.
 */
type Props = {
    /**
     * The text. Genus and species names in it are set in italics.
     */
    text: string;

    /**
     * Whether names with pages (genera, species, clades, rock units, stages, epochs and periods)
     * and glossary terms in the text link to them, each once.
     */
    linkTerms?: boolean;

    /**
     * The links already made, for blocks that link each name or term once between them, such as
     * the items of a list; this adds to it. Giving it also turns linking on.
     */
    linkedTerms?: Set<string>;
};

/**
 * A run of prose: a genus or species name, a name with a page, a glossary term, or plain text.
 */
type ProsePart = {
    /**
     * The text of the run.
     */
    text: string;

    /**
     * True when the run is a genus or species name, which is set in italics.
     */
    isTaxon: boolean;

    /**
     * The path the run links to, relative to the site's base, if any.
     */
    path: string | undefined;

    /**
     * The glossary term the run links to, if any.
     */
    term: GlossaryEntry | undefined;
};

const { text, linkTerms = false } = Astro.props;
const linkedTerms = Astro.props.linkedTerms ?? (linkTerms ? new Set<string>() : undefined);
const baseUrl = import.meta.env.BASE_URL;
const currentPath = Astro.url.pathname.slice(baseUrl.length);
const links = linkedTerms ? getProseLinks() : undefined;
const parts = new Array<ProsePart>();

// Find names first (genera and species, then other names with pages), then glossary terms in the
// remaining text, so links never nest.
for (const segment of getSiteData().taxonNames.splitProse(formatQuotes(text)))
{
    if (!linkedTerms || !links)
    {
        parts.push({ text: segment.text, isTaxon: segment.isTaxon, path: undefined, term: undefined });
    }
    else if (segment.isTaxon)
    {
        const path = findTaxonPath(links, segment.text);
        const isLinked = path !== undefined && !linkedTerms.has(path) && path.split("#")[0] !== currentPath;

        if (isLinked)
        {
            linkedTerms.add(path);
        }

        parts.push({ text: segment.text, isTaxon: true, path: isLinked ? path : undefined, term: undefined });
    }
    else
    {
        for (const named of splitNamedLinks(links, segment.text, linkedTerms, currentPath))
        {
            if (named.path)
            {
                parts.push({ text: named.text, isTaxon: false, path: named.path, term: undefined });
                continue;
            }

            for (const termSegment of splitGlossaryTerms(getGlossary(), named.text, linkedTerms))
            {
                parts.push({ text: termSegment.text, isTaxon: false, path: undefined, term: termSegment.entry });
            }
        }
    }
}

// Keep the markup on one line: whitespace around it would appear in the text.
---
{parts.map((part) => part.path ? <a class:list={{ taxon: part.isTaxon }} href={baseUrl + part.path}>{part.isTaxon ? bindAbbreviatedGenus(part.text) : part.text}</a> : part.isTaxon ? <i class="taxon">{bindAbbreviatedGenus(part.text)}</i> : part.term ? <GlossaryTerm entry={part.term} text={part.text} /> : part.text)}

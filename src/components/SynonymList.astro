---
import type { Synonym } from "../data/dataset.ts";
import Prose from "./Prose.astro";

/**
 * Properties of a stacked list of synonyms, for narrow places such as a species box where a
 * three-column table does not fit. Full-width sections use SynonymTable instead.
 */
type Props = {
    /**
     * The synonyms.
     */
    synonyms: Array<Synonym>;
};

const { synonyms } = Astro.props;
---

<ul class="synonym-list">
    {synonyms.map((synonym) => (
        <li>
            <p class="synonym-heading"><i class="taxon">{synonym.name}</i> <span class="synonym-type">{synonym.type}</span></p>
            {synonym.reason && <p class="synonym-reason"><Prose text={synonym.reason.trim()} /></p>}
        </li>
    ))}
</ul>

<style>
    .synonym-list
    {
        display: grid;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    li
    {
        display: grid;
        gap: var(--space-1);
        padding-block: var(--space-3);
        border-top: 1px solid var(--color-line);
    }

    .synonym-heading
    {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0 var(--space-3);
    }

    .synonym-type
    {
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-small);
    }

    .synonym-reason
    {
        color: var(--color-muted);
        font-size: var(--text-interface);
    }
</style>

---
import type { NotableSpecimen, Reference } from "../data/dataset.ts";
import { formatSpecimenName, formatVocabularyValue } from "../data/format.ts";
import CitationLink from "./CitationLink.astro";
import Prose from "./Prose.astro";

/**
 * Properties of a genus's list of notable specimens.
 */
type Props = {
    /**
     * The notable specimens.
     */
    specimens: Array<NotableSpecimen>;

    /**
     * The genus's references, which each specimen's reference keys resolve against.
     */
    references: Array<Reference>;
};

const { specimens, references } = Astro.props;
---

<ul class="notable-specimens">
    {specimens.map((specimen) => (
        <li>
            {specimen.nickname
                ? <h3 class="specimen-name" data-pagefind-weight="8">{formatSpecimenName(specimen.nickname)}</h3>
                : <h3 class="specimen-name catalog-heading">{specimen.specimen_id?.join(", ") ?? "Unnamed specimen"}</h3>}
            <p class="specimen-facts">
                {specimen.nickname && specimen.specimen_id && specimen.specimen_id.length > 0 && <span class="catalog-number">{specimen.specimen_id.join(", ")}</span>}
                {specimen.institution && <span>{specimen.institution}</span>}
                {specimen.discovered?.year && (
                    <span>Found {specimen.discovered.year}{specimen.discovered.by ? " by " + specimen.discovered.by : ""}</span>
                )}
                {specimen.category && <span class="specimen-category">{formatVocabularyValue(specimen.category)}</span>}
            </p>
            <p><Prose text={specimen.significance.trim()} /></p>
            {specimen.references && specimen.references.length > 0 && (
                <p class="specimen-sources">
                    {specimen.references.map((id) => <CitationLink id={id} references={references} />)}
                </p>
            )}
        </li>
    ))}
</ul>

<style>
    .notable-specimens
    {
        display: grid;
        gap: var(--space-5);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    /* The name heads each specimen, with its details, significance and sources beneath. */
    li
    {
        display: grid;
        gap: var(--space-2);
        max-width: var(--measure);
        padding-bottom: var(--space-5);
        border-bottom: 1px solid var(--color-line);
    }

    .specimen-name
    {
        font-size: var(--text-heading-3);
    }

    /* A specimen without a name is headed by its catalog number, set as catalog numbers are. */
    .catalog-heading
    {
        font-family: var(--font-sans);
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .specimen-facts,
    .specimen-sources
    {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--space-1) var(--space-4);
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-small);
    }

    .specimen-facts:empty
    {
        display: none;
    }

    .catalog-number
    {
        font-weight: 500;
        font-variant-numeric: tabular-nums;
    }

    .specimen-category
    {
        padding: 0 var(--space-2);
        color: var(--color-accent);
        background: var(--color-accent-soft);
        border-radius: var(--radius-small);
        white-space: nowrap;
    }
</style>

---
import type { Reference } from "../data/dataset.ts";
import { getSiteData } from "../data/site-data.ts";
import { createPagePath, createReferenceAnchor } from "../data/urls.ts";
import Citation from "./Citation.astro";
import Prose from "./Prose.astro";

/**
 * Properties of a record's list of references.
 */
type Props = {
    /**
     * The record's references, each with the record's own notes on what it supports.
     */
    references: Array<Reference>;
};

const { references } = Astro.props;
const siteData = getSiteData();
const baseUrl = import.meta.env.BASE_URL;
---

<ol class="reference-list">
    {references.map((reference) => (
        <li id={createReferenceAnchor(siteData.referenceById.get(reference.id)?.slug ?? reference.id)}>
            <Citation reference={reference} />
            {reference.notes && <p class="reference-notes"><Prose text={reference.notes.trim()} /></p>}
            <a class="reference-key" href={createPagePath(baseUrl, "reference", siteData.referenceById.get(reference.id)?.slug ?? "")}>{reference.id}</a>
        </li>
    ))}
</ol>

<style>
    .reference-list
    {
        display: grid;
        gap: var(--space-4);
        margin: 0;
        padding-left: var(--space-5);
        font-size: var(--text-interface);
    }

    li::marker
    {
        color: var(--color-muted);
        font-family: var(--font-sans);
    }

    li:target
    {
        background: var(--color-accent-soft);
    }

    .reference-notes
    {
        margin-top: var(--space-1);
        color: var(--color-muted);
    }

    .reference-key
    {
        display: block;
        width: fit-content;
        margin-top: var(--space-1);
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-caption);
    }
</style>

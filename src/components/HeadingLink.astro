---
/**
 * Properties of the link icon beside a heading.
 */
type Props = {
    /**
     * The heading's id, which the link points to.
     */
    id: string;

    /**
     * The heading's text, for the link's name: "Diagnosis".
     */
    label: string;
};

const { id, label } = Astro.props;
---

{/* A link to the heading, shown on hover or focus (always on touch screens), which goes inside the
   heading after its text. Following it jumps to the heading; src/scripts/heading-links.ts also
   copies its address. The icon is Primer Octicons 19.42.0 (link-16), MIT License. */}
<a class="heading-link" href={"#" + id} aria-label={"Link to “" + label + "”"} data-pagefind-ignore><svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false"><path fill="currentColor" d="m7.775 3.275 1.25-1.25a3.5 3.5 0 1 1 4.95 4.95l-2.5 2.5a3.5 3.5 0 0 1-4.95 0 .751.751 0 0 1 .018-1.042.751.751 0 0 1 1.042-.018 1.998 1.998 0 0 0 2.83 0l2.5-2.5a2.002 2.002 0 0 0-2.83-2.83l-1.25 1.25a.751.751 0 0 1-1.042-.018.751.751 0 0 1-.018-1.042Zm-4.69 9.64a1.998 1.998 0 0 0 2.83 0l1.25-1.25a.751.751 0 0 1 1.042.018.751.751 0 0 1 .018 1.042l-1.25 1.25a3.5 3.5 0 1 1-4.95-4.95l2.5-2.5a3.5 3.5 0 0 1 4.95 0 .751.751 0 0 1-.018 1.042.751.751 0 0 1-1.042.018 1.998 1.998 0 0 0-2.83 0l-2.5 2.5a1.998 1.998 0 0 0 0 2.83Z"></path></svg></a>

<style>
    /* A jump to a linked heading leaves room above it, rather than putting it against the top of
       the window. */
    :global(:is(h2, h3, h4):has(> .heading-link))
    {
        scroll-margin-top: var(--space-5);
    }

    /* Takes its space whether shown or not, so showing it doesn't move the heading's text. */
    .heading-link
    {
        position: relative;
        display: inline-flex;
        align-items: center;
        margin-left: 0.35em;
        padding: 0.1em;
        color: var(--color-muted);
        vertical-align: middle;
        opacity: 0;
        transition: opacity 0.15s;
    }

    .heading-link svg
    {
        width: 0.6em;
        min-width: 14px;
        height: auto;
    }

    /* Also while it says "Link copied.": the jump to the heading moves it out from under the
       pointer. */
    :global(:is(h2, h3, h4):hover) .heading-link,
    .heading-link:focus-visible,
    .heading-link:has(:global(.heading-link-status:not(:empty)))
    {
        opacity: 1;
    }

    .heading-link:hover
    {
        color: var(--color-accent);
    }

    /* Without hover, as on phones, it's always shown. */
    @media (hover: none)
    {
        .heading-link
        {
            opacity: 1;
        }
    }

    @media (prefers-reduced-motion: reduce)
    {
        .heading-link
        {
            transition: none;
        }
    }

    /* "Link copied.", which src/scripts/heading-links.ts writes inside the link. It hangs below the
       icon, ending at its right edge, so it neither moves the text nor runs off a narrow screen. */
    :global(.heading-link-status)
    {
        position: absolute;
        pointer-events: none;
        top: 100%;
        right: 0;
        z-index: 1;
        padding: var(--space-1) var(--space-2);
        color: var(--color-ink);
        background: var(--color-surface);
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
        font-family: var(--font-sans);
        font-size: var(--text-small);
        font-style: normal;
        font-weight: 400;
        letter-spacing: normal;
        white-space: nowrap;
    }

    :global(.heading-link-status:empty)
    {
        display: none;
    }
</style>

---
import type { RangeBarGeometry } from "../data/clades.ts";

/**
 * Properties of a small bar showing an age range on a fixed scale, for table rows.
 */
type Props = {
    /**
     * Where the range sits on the scale.
     */
    geometry: RangeBarGeometry;
};

const { geometry } = Astro.props;
const fillStyle = "left: " + geometry.leftPercent + "%; width: " + geometry.widthPercent + "%";
---

<span class="range-bar" aria-hidden="true"><span class="range-fill" style={fillStyle}></span></span>

<style>
    .range-bar
    {
        position: relative;
        display: block;
        min-width: 6rem;
        height: 0.6rem;
        margin-top: 0.45rem;
        background: var(--color-surface);
        border: 1px solid var(--color-line);
        border-radius: var(--radius-small);
    }

    .range-fill
    {
        position: absolute;
        top: -1px;
        bottom: -1px;
        min-width: 3px;
        background: var(--color-accent);
        border-radius: var(--radius-small);
    }
</style>

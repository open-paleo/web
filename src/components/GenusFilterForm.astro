---
import type { GenusFilterOptions } from "../data/genus-index.ts";
import { formatCount } from "../data/format.ts";

/**
 * The nouns for what a filtered list holds.
 */
type ItemNames = {
    /**
     * The noun for one: "genus".
     */
    singular: string;

    /**
     * The noun for any other count: "genera".
     */
    plural: string;
};

/**
 * Properties of the genus filter form, on the Genera and Map pages.
 */
type Props = {
    /**
     * The filters and their options.
     */
    options: GenusFilterOptions;

    /**
     * Number of genera or clades on the page.
     */
    total: number;

    /**
     * What the list holds, for the form's name and its count: "genus" and "genera" unless given.
     */
    itemNames?: ItemNames;

    /**
     * Whether the fields fold away behind a "Filters" button, leaving one line: the button, the
     * summary and "Clear filters". The Map page folds them so the map fits the first screen.
     */
    isCollapsible: boolean;
};

const { options, total, isCollapsible, itemNames = { singular: "genus", plural: "genera" } } = Astro.props;
---

{/* A reader without JavaScript sees the full list and no controls that do nothing, so the form
   shows only where scripts run (see the styles below). The script reads the filters from the
   page address and writes them back to it, so a filtered list can be shared. */}
<form class:list={["genus-filters", { "is-collapsible": isCollapsible }]} id="genus-filters" data-total={total} data-singular={itemNames.singular} data-plural={itemNames.plural} aria-label={"Filter " + itemNames.plural}>
    <div class="filter-fields" id="genus-filter-fields" hidden={isCollapsible}>
        {options.choices.map((choice) => (
            <label class="filter-field">
                <span class="filter-label">{choice.label}</span>
                <span class="select-box">
                    <select name={choice.name}>
                        <option value="">{choice.anyLabel}</option>
                        {choice.options.map((option) => <option value={option.value} data-label={option.label}>{option.label} ({option.count})</option>)}
                        {choice.groups.map((group) => (
                            <optgroup label={group.label}>
                                {group.options.map((option) => <option value={option.value} data-label={option.label}>{option.label} ({option.count})</option>)}
                            </optgroup>
                        ))}
                    </select>
                </span>
            </label>
        ))}
        {/* A group rather than a fieldset: a legend is laid out apart from the fieldset's other
           content, which put these fields out of line with the lists beside them. */}
        <div class="filter-field filter-years" role="group" aria-labelledby="genus-filter-years">
            <span class="filter-label" id="genus-filter-years">Named</span>
            <span class="year-fields">
                <label>
                    <span class="visually-hidden">Named from</span>
                    <input name="from" type="number" inputmode="numeric" min={options.firstYear} max={options.lastYear} step="1" placeholder={String(options.firstYear)} />
                </label>
                <span aria-hidden="true">to</span>
                <label>
                    <span class="visually-hidden">Named up to</span>
                    <input name="to" type="number" inputmode="numeric" min={options.firstYear} max={options.lastYear} step="1" placeholder={String(options.lastYear)} />
                </label>
            </span>
        </div>
    </div>
    <div class="filter-summary">
        {isCollapsible && <button class="filter-toggle" type="button" id="genus-filter-toggle" aria-expanded="false" aria-controls="genus-filter-fields">Filters</button>}
        <p class="filter-status" id="genus-filter-status" role="status">Showing all {formatCount(total, itemNames.singular, itemNames.plural)}.</p>
        <button class="filter-clear" type="button" id="genus-filter-clear" hidden>Clear filters</button>
    </div>
</form>

<style>
    /* Hidden without scripts. Where the browser reports that scripts run, the form shows from the
       first paint, so the list doesn't jump down when the page's script starts, which on the
       Genera page comes a second after the list (it waits for the whole list to load). A browser
       that can't report it shows the form once the script has connected it. */
    .genus-filters
    {
        display: none;
        gap: var(--space-4);
        padding: var(--space-5);
        background: var(--color-surface);
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
        font-family: var(--font-sans);
    }

    .genus-filters.is-connected
    {
        display: grid;
    }

    @media (scripting: enabled)
    {
        .genus-filters
        {
            display: grid;
        }
    }

    /* The Map page hides the form again when the places it filters can't be loaded. */
    .genus-filters[hidden],
    .filter-fields[hidden],
    .filter-clear[hidden]
    {
        display: none;
    }

    .filter-fields
    {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(min(100%, 12rem), 1fr));
        gap: var(--space-4);
    }

    .filter-field
    {
        display: grid;
        gap: var(--space-1);
        align-content: start;
        min-width: 0;
    }

    .filter-label
    {
        color: var(--color-muted);
        font-size: var(--text-small);
    }

    /* The lists draw their own chevron, inset from the right edge as far as the text is from the
       left; the browser's arrow sits against the edge and ignores padding. */
    .select-box
    {
        position: relative;
        display: grid;
    }

    .select-box::after
    {
        position: absolute;
        top: 50%;
        right: var(--space-3);
        width: 0.45rem;
        height: 0.45rem;
        border-right: 2px solid var(--color-muted);
        border-bottom: 2px solid var(--color-muted);
        content: "";
        pointer-events: none;
        transform: translateY(-70%) rotate(45deg);
    }

    select,
    input
    {
        width: 100%;
        min-width: 0;
        min-height: 2.5rem;
        padding: var(--space-1) var(--space-3);
        color: var(--color-ink);
        background: var(--color-background);
        border: 1px solid color-mix(in srgb, var(--color-line) 40%, var(--color-muted));
        border-radius: var(--radius-small);
        font-size: var(--text-interface);
    }

    select
    {
        padding-right: var(--space-6);
        appearance: none;
    }

    .year-fields
    {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        align-items: center;
        gap: var(--space-2);
        color: var(--color-muted);
    }

    /* On a phone the fields go two to a row, so the form takes half a screen rather than all of
       it; the year range gets a row of its own. */
    @media (max-width: 40rem)
    {
        .genus-filters
        {
            padding: var(--space-4);
        }

        .filter-fields
        {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: var(--space-3);
        }

        .filter-years
        {
            grid-column: 1 / -1;
        }
    }

    /* Folded, the form is one line; the summary leads, and the fields open under it. */
    .genus-filters.is-collapsible
    {
        padding: var(--space-3) var(--space-4);
    }

    .genus-filters.is-collapsible .filter-summary
    {
        order: -1;
        justify-content: flex-start;
    }

    .genus-filters.is-collapsible .filter-clear
    {
        margin-left: auto;
    }

    .filter-toggle
    {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-1) var(--space-4);
        color: var(--color-surface);
        background: var(--color-accent);
        border: 1px solid var(--color-accent);
        border-radius: var(--radius);
        font-size: var(--text-interface);
        font-weight: 700;
        cursor: pointer;
    }

    /* The chevron turns up when the fields are open. */
    .filter-toggle::after
    {
        width: 0.4rem;
        height: 0.4rem;
        border-right: 2px solid currentColor;
        border-bottom: 2px solid currentColor;
        content: "";
        transform: translateY(-25%) rotate(45deg);
    }

    .filter-toggle[aria-expanded="true"]::after
    {
        transform: translateY(25%) rotate(225deg);
    }

    .filter-summary
    {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2) var(--space-5);
    }

    .filter-status
    {
        font-size: var(--text-interface);
    }

    .filter-clear
    {
        padding: var(--space-1) var(--space-4);
        color: var(--color-accent);
        background: var(--color-surface);
        border: 1px solid var(--color-accent);
        border-radius: var(--radius);
        font-size: var(--text-interface);
        cursor: pointer;
    }
</style>

---
import type { IndexRow } from "../data/genus-index.ts";
import { createLetterAnchor, groupByLetter } from "../data/indexes.ts";
import LetterJumpList from "./LetterJumpList.astro";
import GenusListItem from "./GenusListItem.astro";

/**
 * The heading level of the letter headings, so the index fits under a page title (2) or under
 * a section heading (3).
 */
type LetterHeadingLevel = 2 | 3;

/**
 * Properties of a list of genera in columns, each with its authority and a line of details. A
 * long list is grouped under letter headings, with a row of letter links above.
 */
type Props = {
    /**
     * The genera's rows, sorted by name.
     */
    rows: Array<IndexRow>;

    /**
     * What the index lists, for the letter navigation's accessible name: "Genera".
     */
    label: string;

    /**
     * Heading level of the letter headings.
     */
    headingLevel: LetterHeadingLevel;

    /**
     * Whether each genus carries the data attributes the Genera page's filters read.
     */
    isFilterable: boolean;

    /**
     * Whether to group the genera under letter headings. When false the list is one run of
     * columns and the label and heading level are unused.
     */
    isGroupedByLetter: boolean;
};

const { rows, label, headingLevel, isFilterable, isGroupedByLetter } = Astro.props;
const groups = groupByLetter(rows, getRowIndexName);
const letters = new Array<string>();

for (const group of groups)
{
    letters.push(group.letter);
}

/**
 * Get the name a row is sorted and grouped under.
 *
 * @param row - The row.
 * @returns The genus name.
 */
function getRowIndexName(row: IndexRow): string
{
    return row.name;
}
---

<div class="genus-index">
    {isGroupedByLetter && <LetterJumpList letters={letters} label={label} />}
    {/* While a filter is on, the filter script puts copies of the matching genera in this list,
       in name order, and hides the letter groups, so a short result is not spread thinly over
       many letters. */}
    {isFilterable && <ul class="genus-columns genus-results" id="genus-results" aria-label={"Matching " + label.toLowerCase()} hidden></ul>}
    {isGroupedByLetter
        ? groups.map((group) => (
            <section class="letter-group" aria-labelledby={createLetterAnchor(group.letter)} style={"--rows: " + group.entries.length}>
                {headingLevel === 2
                    ? <h2 class="letter-heading" id={createLetterAnchor(group.letter)}>{group.letter}</h2>
                    : <h3 class="letter-heading" id={createLetterAnchor(group.letter)}>{group.letter}</h3>}
                <ul class="genus-columns">
                    {group.entries.map((row) => <GenusListItem row={row} isFilterable={isFilterable} />)}
                </ul>
            </section>
        ))
        : (
            <ul class="genus-columns">
                {rows.map((row) => <GenusListItem row={row} isFilterable={isFilterable} />)}
            </ul>
        )}
</div>

<style>
    .genus-index
    {
        display: grid;
        gap: var(--space-6);
        container-type: inline-size;
    }

    /* The browser lays out a letter group only near the screen, which on the Genera page saves
       laying out over a thousand genera in columns at once. Until then it holds the group's
       height as estimated from its row count, about 4.4rem a genus in each column, and once
       laid out, its real height. */
    .letter-group
    {
        --columns: 1;
        display: grid;
        gap: var(--space-4);
        scroll-margin-top: var(--space-5);
        content-visibility: auto;
        contain-intrinsic-block-size: auto calc(4rem + var(--rows) * 4.4rem / var(--columns));
    }

    /* Likewise each matching genus while a filter is on, so a broad filter doesn't lay out
       hundreds of genera in columns at once. 3.3rem is a genus's height without its padding. */
    .genus-results > :global(li)
    {
        content-visibility: auto;
        contain-intrinsic-block-size: auto 3.3rem;
    }

    /* The column counts .genus-columns gives at each width: columns of 20rem with 3rem gaps. */
    @container (min-width: 43rem)
    {
        .letter-group
        {
            --columns: 2;
        }
    }

    @container (min-width: 66rem)
    {
        .letter-group
        {
            --columns: 3;
        }
    }

    @container (min-width: 89rem)
    {
        .letter-group
        {
            --columns: 4;
        }
    }

    /* The Genera page's filters hide the letter groups, or the list of matches, with the hidden
       attribute, which the display rules here would otherwise override. */
    .letter-group[hidden],
    .genus-columns[hidden]
    {
        display: none;
    }

    .letter-heading
    {
        padding-bottom: var(--space-2);
        border-bottom: 1px solid var(--color-line);
        font-size: var(--text-heading-3);
    }

    /* Genera flow down columns, as in a printed index. */
    .genus-columns
    {
        margin: 0;
        padding: 0;
        list-style: none;
        columns: 20rem auto;
        column-gap: var(--space-7);
    }
</style>

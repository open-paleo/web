---
import { formatAuthority } from "../data/format.ts";
import { createLetterAnchor, getGenusIndexName, groupByLetter } from "../data/indexes.ts";
import type { GenusEntry } from "../data/site-data.ts";
import { createPagePath } from "../data/urls.ts";
import LetterJumpList from "./LetterJumpList.astro";

/**
 * The heading level of the letter headings, so the index fits under a page title (2) or under
 * a section heading (3).
 */
type LetterHeadingLevel = 2 | 3;

/**
 * Properties of an A–Z index of genera: a row of letter links, then the genera under each
 * letter in columns, each with its authority.
 */
type Props = {
    /**
     * The genera, sorted by name.
     */
    genera: Array<GenusEntry>;

    /**
     * What the index lists, for the letter navigation's accessible name: "Genera".
     */
    label: string;

    /**
     * Heading level of the letter headings.
     */
    headingLevel: LetterHeadingLevel;
};

const { genera, label, headingLevel } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
const groups = groupByLetter(genera, getGenusIndexName);
const letters = new Array<string>();

for (const group of groups)
{
    letters.push(group.letter);
}

---

<div class="genus-index">
    <LetterJumpList letters={letters} label={label} />
    {groups.map((group) => (
        <section class="letter-group" aria-labelledby={createLetterAnchor(group.letter)}>
            {headingLevel === 2
                ? <h2 class="letter-heading" id={createLetterAnchor(group.letter)}>{group.letter}</h2>
                : <h3 class="letter-heading" id={createLetterAnchor(group.letter)}>{group.letter}</h3>}
            <ul class="genus-columns">
                {group.entries.map((genus) => (
                    <li>
                        <a class="taxon" href={createPagePath(baseUrl, "genus", genus.slug)}>{genus.name}</a>
                        <span class="genus-authority">{formatAuthority(genus.record.authors, genus.record.described, false)}</span>
                    </li>
                ))}
            </ul>
        </section>
    ))}
</div>

<style>
    .genus-index
    {
        display: grid;
        gap: var(--space-6);
    }

    .letter-group
    {
        display: grid;
        gap: var(--space-4);
        scroll-margin-top: var(--space-5);
    }

    .letter-heading
    {
        padding-bottom: var(--space-2);
        border-bottom: 1px solid var(--color-line);
        font-size: var(--text-heading-3);
    }

    /* Names flow down columns, as in a printed index. */
    .genus-columns
    {
        margin: 0;
        padding: 0;
        list-style: none;
        columns: 16rem auto;
        column-gap: var(--space-7);
    }

    li
    {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: 0 var(--space-2);
        padding-block: var(--space-1);
        break-inside: avoid;
    }

    .genus-authority
    {
        color: var(--color-muted);
        font-family: var(--font-sans);
        font-size: var(--text-small);
    }
</style>

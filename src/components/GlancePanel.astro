---
import type { Genus } from "../data/dataset.ts";
import {
    capitalizeFirstLetter,
    formatPlace,
    formatStratigraphicUnits,
    getIdentifierSourceName,
    getIdentifierUrl,
    joinNonEmpty,
} from "../data/format.ts";
import { getTypeSpecies, listSizeMeasurements } from "../data/records.ts";
import FactList from "./FactList.astro";

/**
 * Properties of the "at a glance" panel beside a genus's description.
 */
type Props = {
    /**
     * The genus record. Size and place come from its type species.
     */
    genus: Genus;
};

const { genus } = Astro.props;
const typeSpecies = getTypeSpecies(genus);
const appearance = genus.appearance;
const integument = appearance?.integument && appearance.integument !== "unknown"
    ? capitalizeFirstLetter(appearance.integument)
    : "";
const foundIn = typeSpecies.location
    ? joinNonEmpty([formatStratigraphicUnits(typeSpecies.location), formatPlace(typeSpecies.location)])
    : "";
const measurements = listSizeMeasurements(typeSpecies.size);
const identifiers = genus.identifiers ?? [];
const sizeNote = genus.species.length > 1 ? "Size and place are those of the type species." : "";
---

<FactList label="At a glance">
    {genus.diet && (
        <>
            <dt>Diet</dt>
            <dd>{capitalizeFirstLetter(genus.diet)}</dd>
        </>
    )}
    {genus.locomotion && (
        <>
            <dt>Locomotion</dt>
            <dd>{capitalizeFirstLetter(genus.locomotion)}</dd>
        </>
    )}
    {integument && (
        <>
            <dt>Integument</dt>
            <dd>{integument}{appearance?.evidence && <span class="glance-muted"> ({appearance.evidence} evidence)</span>}</dd>
        </>
    )}
    {appearance?.features && appearance.features.length > 0 && (
        <>
            <dt>Features</dt>
            <dd class="chips">{appearance.features.map((feature) => <span class="chip">{feature}</span>)}</dd>
        </>
    )}
    {genus.paleoenvironment && genus.paleoenvironment.length > 0 && (
        <>
            <dt>Environment</dt>
            <dd>{capitalizeFirstLetter(genus.paleoenvironment.join(", "))}</dd>
        </>
    )}
    {measurements.map((measurement) => (
        <>
            <dt>{measurement.label}</dt>
            <dd class="figures">{measurement.value}</dd>
        </>
    ))}
    {foundIn && (
        <>
            <dt>Found in</dt>
            <dd>{foundIn}</dd>
        </>
    )}
    {identifiers.length > 0 && (
        <>
            <dt>Elsewhere</dt>
            <dd class="identifiers">
                {identifiers.map((identifier) => (
                    <a href={getIdentifierUrl(identifier.source ?? "", identifier.id ?? "")}>{getIdentifierSourceName(identifier.source ?? "")}</a>
                ))}
            </dd>
        </>
    )}
    {sizeNote && <p class="glance-note" slot="note">{sizeNote}</p>}
</FactList>

<style>
    .glance-muted,
    .glance-note
    {
        color: var(--color-muted);
    }

    .glance-note
    {
        font-family: var(--font-sans);
        font-size: var(--text-small);
    }

    .chips,
    .identifiers
    {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1) var(--space-3);
    }

    .chips
    {
        gap: var(--space-1);
    }

    .chip
    {
        padding: 0 var(--space-2);
        border: 1px solid var(--color-line);
        border-radius: 999px;
        font-size: var(--text-small);
        white-space: nowrap;
    }
</style>

---
import type { Genus } from "../data/dataset.ts";
import {
    capitalizeFirstLetter,
    formatIntegumentEvidence,
    formatLocomotion,
    formatPlace,
    formatStratigraphicUnits,
    joinNonEmpty,
} from "../data/format.ts";
import { getTypeSpecies, getSizeMeasurements } from "../data/records.ts";
import FactList from "./FactList.astro";
import IdentifierLinks from "./IdentifierLinks.astro";
import TermLink from "./TermLink.astro";
import UnitLinks from "./UnitLinks.astro";

/**
 * Properties of the "at a glance" panel beside a genus's description.
 */
type Props = {
    /**
     * The genus record. Size and place come from its type species.
     */
    genus: Genus;
};

const { genus } = Astro.props;
const typeSpecies = getTypeSpecies(genus);
const appearance = genus.appearance;
const integument = appearance?.integument && appearance.integument !== "unknown"
    ? capitalizeFirstLetter(appearance.integument)
    : "";
const foundUnits = typeSpecies.location ? formatStratigraphicUnits(typeSpecies.location) : "";
const foundPlace = typeSpecies.location ? formatPlace(typeSpecies.location) : "";
const foundIn = typeSpecies.location
    ? joinNonEmpty([foundUnits, foundPlace])
    : "";
const measurements = getSizeMeasurements(typeSpecies.size);
const identifiers = genus.identifiers ?? [];
const hasSizeNote = genus.species.length > 1;
const locomotion = genus.locomotion ? formatLocomotion(genus.locomotion) : "";
---

<FactList label="At a glance">
    {genus.diet && (
        <>
            <dt>Diet</dt>
            <dd>{capitalizeFirstLetter(genus.diet)}</dd>
        </>
    )}
    {locomotion && (
        <>
            <dt>Locomotion</dt>
            <dd><TermLink term={locomotion} text={capitalizeFirstLetter(locomotion)} /></dd>
        </>
    )}
    {integument && (
        <>
            <dt>Integument</dt>
            <dd>{integument}{appearance?.evidence && <span class="glance-muted"> ({formatIntegumentEvidence(appearance.evidence)})</span>}</dd>
        </>
    )}
    {appearance?.features && appearance.features.length > 0 && (
        <>
            <dt>Features</dt>
            <dd>{capitalizeFirstLetter(appearance.features.join(", "))}</dd>
        </>
    )}
    {genus.paleoenvironment && genus.paleoenvironment.length > 0 && (
        <>
            <dt>Environment</dt>
            <dd>{capitalizeFirstLetter(genus.paleoenvironment.join(", "))}</dd>
        </>
    )}
    {measurements.map((measurement) => (
        <>
            <dt>{measurement.label}</dt>
            <dd class="figures">{measurement.value}</dd>
        </>
    ))}
    {foundIn && (
        <>
            <dt>Found in</dt>
            <dd>{typeSpecies.location && <UnitLinks location={typeSpecies.location} />}{foundUnits && foundPlace && ", "}{foundPlace}</dd>
        </>
    )}
    {identifiers.length > 0 && (
        <>
            <dt>Other databases</dt>
            <IdentifierLinks identifiers={identifiers} />
        </>
    )}
    {hasSizeNote && <p class="glance-note" slot="note">Size and place are for the <TermLink term="type species" />, <i class="taxon">{typeSpecies.name}</i>.</p>}
</FactList>

<style>
    .glance-muted,
    .glance-note
    {
        color: var(--color-muted);
    }

    .glance-note
    {
        font-family: var(--font-sans);
        font-size: var(--text-small);
    }
</style>

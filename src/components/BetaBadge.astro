---
// No properties: the badge always reads "Beta".
---

{/* Marks a tool that is usable but still being improved, in the caution colors. */}
<span class="beta-badge">Beta</span>

<style>
    .beta-badge
    {
        padding: var(--space-1) var(--space-3);
        color: var(--color-caution);
        background: var(--color-caution-soft);
        border-radius: var(--radius);
        font-family: var(--font-sans);
        font-size: var(--text-interface);
        font-style: normal;
        font-weight: 700;
        letter-spacing: normal;
        white-space: nowrap;
    }
</style>

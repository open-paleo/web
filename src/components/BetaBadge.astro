---
/**
 * Properties of a beta badge.
 */
type Props = {
    /**
     * The tool's version, shown after "Beta": "0.3.0".
     */
    version: string;
};

const { version } = Astro.props;
---

{/* Marks a tool that is usable but still being improved, in the caution colors, with the
    version the site runs. */}
<span class="beta-badge">Beta <span class="beta-version">{version}</span></span>

<style>
    .beta-badge
    {
        padding: var(--space-1) var(--space-3);
        color: var(--color-caution);
        background: var(--color-caution-soft);
        border-radius: var(--radius);
        font-family: var(--font-sans);
        font-size: var(--text-interface);
        font-style: normal;
        font-weight: 700;
        letter-spacing: normal;
        white-space: nowrap;
    }

    .beta-version
    {
        margin-left: var(--space-1);
        font-variant-numeric: tabular-nums;
        font-weight: 400;
    }
</style>

---
import type { Reference } from "../data/dataset.ts";
import { createCitationParts } from "../data/format.ts";
import Prose from "./Prose.astro";

/**
 * Properties of a full citation of a published work.
 */
type Props = {
    /**
     * The reference.
     */
    reference: Reference;

    /**
     * Where the title links: the reference's page on this site, in a record's reference list.
     * Left out on the reference's own page, where the title isn't a link.
     */
    titleHref?: string;
};

const { reference, titleHref } = Astro.props;
const parts = createCitationParts(reference);
const doiUrl = "https://doi.org/" + parts.doi;
const locationAfterContainer = parts.location ? " " + parts.location : "";
---

{/* One line on purpose: Astro's HTML compression drops line breaks between expressions, so every space between parts is written out. */}
<span class="citation">{parts.authors} ({parts.year}). {titleHref ? <a href={titleHref}><Prose text={parts.title} /></a> : <Prose text={parts.title} />}.{parts.container && <>{" "}<i>{parts.container}</i>{locationAfterContainer}.</>}{!parts.container && parts.location && <>{" "}{parts.location}.</>}{parts.publisher && <>{" "}{parts.publisher}.</>}{parts.doi && <>{" "}<a href={doiUrl}>doi:{parts.doi}</a></>}{parts.url && <>{" "}<a href={parts.url}>{parts.url}</a></>}</span>

<style>
    /* Addresses and DOIs have no spaces to wrap at; long ones would widen narrow screens. */
    .citation a
    {
        overflow-wrap: anywhere;
    }
</style>

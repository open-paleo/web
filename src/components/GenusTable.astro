---
import type { CladeGenusRow } from "../data/clades.ts";
import { createPagePath } from "../data/urls.ts";
import RangeBar from "./RangeBar.astro";
import StatusBadge from "./StatusBadge.astro";

/**
 * Where a genus table appears, which decides one column: on a clade page, a genus's placement
 * (incertae sedis) is relative to that clade; on a time page, each genus's clade is shown instead.
 */
type GenusTableContext = "clade" | "time";

/**
 * Properties of a table of genera.
 */
type Props = {
    /**
     * The formatted rows.
     */
    rows: Array<CladeGenusRow>;

    /**
     * Heading of the range column, naming the scale the bars are drawn on.
     */
    rangeHeading: string;

    /**
     * Where the table appears.
     */
    context: GenusTableContext;
};

const { rows, rangeHeading, context } = Astro.props;
const baseUrl = import.meta.env.BASE_URL;
---

<div class="table-scroll" tabindex="0" role="region" aria-label="Genera">
    <table class="genus-table">
        <thead>
            <tr>
                <th scope="col">Genus</th>
                {context === "time" && <th scope="col">Clade</th>}
                <th scope="col">Authority</th>
                <th scope="col">Age</th>
                <th scope="col" class="numeric">Ma</th>
                <th scope="col" class="range-heading">{rangeHeading}</th>
                <th scope="col">Found in</th>
            </tr>
        </thead>
        <tbody>
            {rows.map((row) => (
                <tr>
                    <td class="genus-cell">
                        <a class="taxon" href={createPagePath(baseUrl, "genus", row.entry.slug)}>{row.entry.name}</a>
                        <StatusBadge status={row.status} />
                        {context === "clade" && row.isIncertaeSedis && <span class="row-note"><i>incertae sedis</i></span>}
                        {row.isDisputed && <span class="row-note row-dispute">under dispute</span>}
                    </td>
                    {context === "time" && (
                        <td class="text-cell">{row.parentSlug ? <a href={createPagePath(baseUrl, "clade", row.parentSlug)}>{row.parentName}</a> : row.parentName}</td>
                    )}
                    <td class="text-cell">{row.authority}</td>
                    <td class="text-cell">{row.age}</td>
                    <td class="numeric figures">{row.ageNumbers}</td>
                    <td class="range-cell">{row.rangeBar && <RangeBar geometry={row.rangeBar} />}</td>
                    <td class="text-cell">{row.country}</td>
                </tr>
            ))}
        </tbody>
    </table>
</div>

<style>
    .table-scroll
    {
        overflow-x: auto;
    }

    /* Columns are separated by vertical rules, with equal padding either side of each rule. */
    th,
    td
    {
        padding-inline: var(--space-3);
    }

    th + th,
    td + td
    {
        border-left: 1px solid var(--color-line);
    }

    th:first-child,
    td:first-child
    {
        padding-left: 0;
    }

    th:last-child,
    td:last-child
    {
        padding-right: 0;
    }

    .numeric
    {
        text-align: right;
        white-space: nowrap;
    }

    /* Cells keep to one line (the genus cell's notes are on lines of their own by design); on a
       narrow screen the table scrolls sideways inside its container instead. */
    .text-cell
    {
        white-space: nowrap;
    }

    .genus-cell
    {
        min-width: 10rem;
        white-space: nowrap;
    }

    .genus-cell :global(.status-badge)
    {
        margin-left: var(--space-2);
    }

    .row-note
    {
        display: block;
        color: var(--color-muted);
        font-size: var(--text-caption);
    }

    .row-dispute
    {
        color: var(--color-caution);
    }

    /* The range column takes whatever width the other columns leave. */
    .range-heading,
    .range-cell
    {
        width: 100%;
        min-width: 8rem;
    }
</style>

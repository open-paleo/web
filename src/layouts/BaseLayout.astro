---
import "../theme/theme.css";
import { getSiteData } from "../data/site-data.ts";

/**
 * The sections of the site that have a link in the header.
 */
type NavigationSection = "genera" | "tree" | "map" | "references" | "data";

/**
 * One link in the header's navigation.
 */
type NavigationItem = {
    /**
     * The section the link leads to.
     */
    section: NavigationSection;

    /**
     * The link text.
     */
    label: string;

    /**
     * Path of the section's index page, relative to the site's base.
     */
    path: string;
};

/**
 * Properties of the base layout, which every page uses.
 */
type Props = {
    /**
     * Page title without the site name. Omit it on the home page, whose title is the site name.
     */
    title?: string;

    /**
     * One sentence describing the page, for search engines and link previews.
     */
    description: string;

    /**
     * The section the page belongs to, whose header link is marked as current. Genus pages
     * belong to Genera, clade pages to Tree, and reference pages to References.
     */
    section?: NavigationSection;

    /**
     * Text already in the search field, on the search page.
     */
    searchQuery?: string;
};

const { title, description, section, searchQuery = "" } = Astro.props;
const siteName = "Open Paleo";
const documentTitle = title ? title + " | " + siteName : siteName;
const homeUrl = import.meta.env.BASE_URL;
const release = getSiteData().metadata;
// The canonical address and the sitemap link need the site's address, which local builds lack.
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const sitemapUrl = Astro.site ? new URL(homeUrl + "sitemap-index.xml", Astro.site).href : undefined;
// Link previews (Open Graph, read by Slack, Mastodon, iMessage and others, and Twitter cards)
// show the page's title and description over one site-wide image, drawn by
// scripts/create-social-image.ts. Their image and address must be absolute, so like the
// canonical link they appear only where the site's address is known.
const previewImageUrl = Astro.site ? new URL(homeUrl + "social-preview.png", Astro.site).href : undefined;
const previewImageDescription = siteName + ": a community-maintained phylogenetic dataset for paleontology, over the Triassic, Jurassic and Cretaceous periods in the colors of the geologic time scale.";
const navigationItems: Array<NavigationItem> = [
    { section: "genera", label: "Genera", path: "genera/" },
    { section: "tree", label: "Tree", path: "tree/" },
    { section: "map", label: "Map", path: "map/" },
    { section: "references", label: "References", path: "references/" },
    { section: "data", label: "Data", path: "data/" },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content={description}>
        <title>{documentTitle}</title>
        <link rel="icon" href={homeUrl + "favicon.ico"} sizes="16x16 32x32 48x48">
        <link rel="apple-touch-icon" href={homeUrl + "apple-touch-icon.png"}>
        {canonicalUrl && <link rel="canonical" href={canonicalUrl}>}
        {sitemapUrl && <link rel="sitemap" href={sitemapUrl}>}
        <meta property="og:site_name" content={siteName}>
        <meta property="og:type" content="website">
        <meta property="og:title" content={title ?? siteName}>
        <meta property="og:description" content={description}>
        {canonicalUrl && <meta property="og:url" content={canonicalUrl}>}
        {previewImageUrl && <meta property="og:image" content={previewImageUrl}>}
        {previewImageUrl && <meta property="og:image:width" content="1200">}
        {previewImageUrl && <meta property="og:image:height" content="630">}
        {previewImageUrl && <meta property="og:image:alt" content={previewImageDescription}>}
        <meta name="twitter:card" content={previewImageUrl ? "summary_large_image" : "summary"}>
    </head>
    <body>
        <a class="skip-link" href="#content">Skip to content</a>
        <header class="site-header">
            <div class="site-header-inner">
                <a class="wordmark" href={homeUrl}>{siteName}</a>
                <nav class="site-navigation" aria-label="Main">
                    <ul>
                        {navigationItems.map((item) => (
                            <li>
                                <a href={homeUrl + item.path} aria-current={item.section === section ? "page" : undefined}>{item.label}</a>
                            </li>
                        ))}
                    </ul>
                </nav>
                {/* GitHub's mark from Primer Octicons 19.42.0 (mark-github-24), MIT License. */}
                <a class="github-link" href="https://github.com/open-paleo" aria-label="Open Paleo on GitHub">
                    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943"></path></svg>
                </a>
                <form class="site-search" role="search" action={homeUrl + "search/"} method="get">
                    <label class="visually-hidden" for="site-search-field">Search the dataset</label>
                    <input
                        id="site-search-field"
                        name="q"
                        type="search"
                        value={searchQuery}
                        placeholder="Search genera, clades, references"
                        autocomplete="off"
                        >
                    <button type="submit">Search</button>
                </form>
            </div>
        </header>
        <main class="site-main" id="content" tabindex="-1">
            <slot />
        </main>
        <footer class="site-footer">
            <div class="site-footer-inner">
                <div class="footer-about">
                    <a class="footer-wordmark" href={homeUrl}>{siteName}</a>
                    <p>A community-maintained phylogenetic dataset for paleontology, backed by published literature.</p>
                </div>
                <ul class="footer-links">
                    <li><a href={homeUrl + "data/"}>Download and cite the data</a></li>
                    <li><a href="https://github.com/open-paleo/data">Dataset on GitHub</a></li>
                    <li><a href="https://github.com/open-paleo/web">Site source on GitHub</a></li>
                </ul>
                <p class="footer-license">
                    Data by Open Paleo contributors, licensed under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
                    Site code licensed under the <a href="https://github.com/open-paleo/web/blob/main/LICENSE">MIT License</a>.
                    Built from release {release.version}.
                    Site icon: <a href="https://www.flaticon.com/free-icons/fossil" title="fossil icons">Fossil icons created by Smashicons - Flaticon</a>.
                </p>
            </div>
        </footer>
    </body>
</html>

<style>
    .skip-link
    {
        position: absolute;
        top: var(--space-2);
        left: var(--space-2);
        z-index: 10;
        padding: var(--space-2) var(--space-4);
        color: var(--color-ink);
        background: var(--color-surface);
        border: 2px solid var(--color-accent);
        border-radius: var(--radius);
        font-family: var(--font-sans);
        transform: translateY(-200%);
    }

    .skip-link:focus
    {
        transform: none;
    }

    /* A full-width dark band. Its contents line up with the page content below. */
    .site-header
    {
        position: relative;
        color: var(--color-header-ink);
        background: var(--color-header-background);
        border-bottom: 1px solid var(--color-header-edge);
        font-family: var(--font-sans);
    }

    /* The header, main content and footer share one column width and side gutter. */
    .site-header-inner,
    .site-main,
    .site-footer-inner
    {
        max-width: var(--page-width);
        margin-inline: auto;
        padding-inline: max(var(--space-4), env(safe-area-inset-left, 0px)) max(var(--space-4), env(safe-area-inset-right, 0px));
    }

    /* The footer repeats the header's dark band, so the two frame the page. */
    .site-footer
    {
        color: var(--color-header-muted);
        background: var(--color-header-background);
        border-top: 1px solid var(--color-header-edge);
        font-family: var(--font-sans);
        font-size: var(--text-small);
    }

    .site-footer-inner
    {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
        gap: var(--space-5) var(--space-7);
        padding-block: var(--space-6) var(--space-7);
    }

    .footer-about
    {
        display: grid;
        gap: var(--space-2);
        max-width: 28rem;
    }

    .footer-wordmark
    {
        color: var(--color-header-ink);
        font-family: var(--font-serif);
        font-size: var(--text-heading-3);
        font-weight: 800;
        text-decoration: none;
    }

    .footer-links
    {
        display: grid;
        gap: var(--space-2);
        align-content: start;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .site-footer a
    {
        color: var(--color-header-ink);
    }

    .footer-license
    {
        grid-column: 1 / -1;
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-header-border);
    }

    .site-footer :focus-visible
    {
        outline-color: var(--color-header-accent);
    }

    .site-header-inner
    {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3) var(--space-6);
        padding-block: var(--space-4);
    }

    .wordmark
    {
        color: var(--color-header-ink);
        font-family: var(--font-serif);
        font-size: var(--text-heading-2);
        font-weight: 800;
        line-height: 1;
        text-decoration: none;
    }

    .site-navigation ul
    {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1) var(--space-5);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .site-navigation a
    {
        display: inline-block;
        padding-block: var(--space-1);
        color: var(--color-header-muted);
        font-size: var(--text-interface);
        text-decoration: none;
        border-bottom: 2px solid transparent;
    }

    .site-navigation a:hover
    {
        color: var(--color-header-ink);
    }

    .site-navigation a[aria-current="page"]
    {
        color: var(--color-header-ink);
        border-bottom-color: var(--color-header-accent);
    }

    /* The GitHub link starts the header's right-hand group, so it sits just left of search. */
    .github-link
    {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        margin-left: auto;
        color: var(--color-header-muted);
        border-radius: var(--radius);
    }

    .github-link:hover
    {
        color: var(--color-header-ink);
        background: var(--color-header-surface);
    }

    .site-search
    {
        display: flex;
        flex: 1 1 18rem;
        justify-content: flex-end;
        gap: var(--space-2);
        max-width: 28rem;
    }

    .site-search input
    {
        flex: 1 1 auto;
        min-width: 0;
        padding: var(--space-2) var(--space-3);
        color: var(--color-header-ink);
        background: var(--color-header-surface);
        border: 1px solid var(--color-header-border);
        border-radius: var(--radius);
        font-size: var(--text-interface);
    }

    .site-search input::placeholder
    {
        color: var(--color-header-muted);
    }

    .site-search button
    {
        padding: var(--space-2) var(--space-4);
        color: var(--color-header-background);
        background: var(--color-header-accent);
        border: 1px solid var(--color-header-accent);
        border-radius: var(--radius);
        font-size: var(--text-interface);
        font-weight: 700;
        cursor: pointer;
    }

    .site-header :focus-visible
    {
        outline-color: var(--color-header-accent);
    }

    .site-main
    {
        padding-block: var(--space-6) var(--space-8);
    }

    .site-main:focus
    {
        outline: none;
    }

    @media (max-width: 40rem)
    {
        .site-footer-inner
        {
            grid-template-columns: minmax(0, 1fr);
        }

        .site-search
        {
            flex-basis: 100%;
            max-width: none;
            margin-left: 0;
        }

        .github-link
        {
            position: absolute;
            top: var(--space-4);
            right: max(var(--space-4), env(safe-area-inset-right, 0px));
        }
    }
</style>

---
import "../theme/theme.css";
import { formatQuotes } from "../data/format.ts";
import { createNavigationGroups, findNavigationGroup } from "../data/navigation.ts";
import { getSiteData } from "../data/site-data.ts";
import type { StructuredData } from "../data/structured-data.ts";
import { writeJsonLd } from "../data/structured-data.ts";
import { getHeaderColors } from "../data/theme-colors.ts";
import { getTimePages } from "../data/time-pages.ts";

/**
 * Properties of the base layout, which every page uses.
 */
type Props = {
    /**
     * Page title without the site name. Omit it on the home page, whose title is the site name.
     */
    title?: string;

    /**
     * One sentence describing the page, for search engines and link previews.
     */
    description: string;

    /**
     * The navigation id of the page the current one belongs to (src/data/navigation.ts): its
     * group is marked in the header and its pages shown in the second row. Genus pages belong to
     * Genera, clade pages to Clades, stage pages to their period, unit pages to Stratigraphy and
     * reference pages to References.
     */
    navigationItem?: string;

    /**
     * Text already in the search field, on the search page.
     */
    searchQuery?: string;

    /**
     * Whether the header's search field suggests names as the reader types. The search page
     * turns it off, since its results already follow the field.
     */
    hasSearchSuggestions?: boolean;

    /**
     * The page's subject as schema.org structured data, written into the head as JSON-LD. Its
     * addresses are absolute, so pages give it only when the site's address is known.
     */
    structuredData?: StructuredData;
};

const { navigationItem, searchQuery = "", hasSearchSuggestions = true, structuredData } = Astro.props;
// Titles and descriptions often come from the dataset.
const title = Astro.props.title === undefined ? undefined : formatQuotes(Astro.props.title);
const description = formatQuotes(Astro.props.description);
const siteName = "Open Paleo";
const documentTitle = title ? title + " | " + siteName : siteName;
const homeUrl = import.meta.env.BASE_URL;
const release = getSiteData().metadata;
// Plausible counts page views on the published site only; local and CI builds have no site
// address.
const isCountingVisits = Astro.site !== undefined;
// Plausible's queue snippet, verbatim. It's emitted as text because it doesn't follow this
// site's code style.
const plausibleQueueScript = "window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};plausible.init()";
// The canonical address and the sitemap link need the site's address, which local builds lack.
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const sitemapUrl = Astro.site ? new URL(homeUrl + "sitemap-index.xml", Astro.site).href : undefined;
// Link previews (Open Graph and Twitter cards) need absolute addresses, so like the canonical
// link they're only added when the site's address is known.
const previewImageUrl = Astro.site ? new URL(homeUrl + "social-preview.png", Astro.site).href : undefined;
const previewImageDescription = siteName + ": a community-maintained phylogenetic dataset for paleontology, over the Triassic, Jurassic and Cretaceous periods in the colors of the geologic time scale.";
// The header's color in each scheme, from the theme's tokens, for the theme-color meta tags.
const headerColors = getHeaderColors();
// Escaped by writeJsonLd so dataset text in it can't end the script element.
const structuredDataText = structuredData ? writeJsonLd(structuredData) : undefined;
const navigationGroups = createNavigationGroups(getTimePages().periods);
const currentGroup = findNavigationGroup(navigationGroups, navigationItem);
// A second-row link is marked as the current page only on that page; a genus page marks Genera
// as its section instead.
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en" data-base-url={homeUrl}>
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content={description}>
        <title>{documentTitle}</title>
        {/* Both schemes before the stylesheet loads, so dark mode starts dark; phones color their
            toolbars like the header (Safari on iOS 26 reads the body's background instead; see below);
            Safari on iOS leaves catalog numbers and ages alone. */}
        <meta name="color-scheme" content="light dark">
        <meta name="theme-color" media="(prefers-color-scheme: light)" content={headerColors.light}>
        <meta name="theme-color" media="(prefers-color-scheme: dark)" content={headerColors.dark}>
        <meta name="format-detection" content="telephone=no">
        <link rel="alternate" type="application/atom+xml" title="Open Paleo: newly named genera" href={homeUrl + "feed.xml"}>
        {canonicalUrl && <link rel="canonical" href={canonicalUrl}>}
        {sitemapUrl && <link rel="sitemap" href={sitemapUrl}>}
        {canonicalUrl && <link rel="search" type="application/opensearchdescription+xml" title={siteName} href={homeUrl + "opensearch.xml"}>}
        <meta property="og:site_name" content={siteName}>
        <meta property="og:type" content="website">
        <meta property="og:title" content={title ?? siteName}>
        <meta property="og:description" content={description}>
        {canonicalUrl && <meta property="og:url" content={canonicalUrl}>}
        {previewImageUrl && <meta property="og:image" content={previewImageUrl}>}
        {previewImageUrl && <meta property="og:image:width" content="1200">}
        {previewImageUrl && <meta property="og:image:height" content="630">}
        {previewImageUrl && <meta property="og:image:alt" content={previewImageDescription}>}
        <meta name="twitter:card" content={previewImageUrl ? "summary_large_image" : "summary"}>
        {structuredDataText && <script is:inline type="application/ld+json" set:html={structuredDataText}></script>}
        {isCountingVisits && (
            <>
                <script is:inline async src="https://plausible.io/js/pa-kxif62VY-48TH3yxyC6EQ.js"></script>
                <script is:inline set:html={plausibleQueueScript}></script>
            </>
        )}
    </head>
    <body>
        <a class="skip-link" href="#content">Skip to content</a>
        <header class="site-header">
            <div class="site-header-inner">
                <a class="wordmark" href={homeUrl}>{siteName}</a>
                <nav class="site-navigation" aria-label="Main">
                    <ul>
                        {navigationGroups.map((group) => (
                            <li>
                                <a href={homeUrl + group.items[0].path} aria-current={group === currentGroup ? "true" : undefined}>{group.label}</a>
                            </li>
                        ))}
                    </ul>
                </nav>
                {/* GitHub's mark from Primer Octicons 19.42.0 (mark-github-24), MIT License. */}
                <a class="github-link" href="https://github.com/open-paleo" aria-label="Open Paleo on GitHub">
                    <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943"></path></svg>
                </a>
                <form class="site-search" role="search" action={homeUrl + "search/"} method="get">
                    <label class="visually-hidden" for="site-search-field">Search the dataset</label>
                    <input
                        id="site-search-field"
                        name="q"
                        type="search"
                        value={searchQuery}
                        placeholder="Genus, clade, author"
                        autocomplete="off"
                        data-suggestions={hasSearchSuggestions ? "" : undefined}
                        >
                    <button type="submit">Search</button>
                </form>
            </div>
            {/* The second row: the pages of the group the current page belongs to. */}
            {currentGroup && (
                <div class="group-navigation">
                    <nav class="group-navigation-inner" aria-label={currentGroup.label}>
                        <ul>
                            {currentGroup.items.map((item) => (
                                <li>
                                    <a href={homeUrl + item.path} aria-current={homeUrl + item.path === currentPath ? "page" : item.id === navigationItem ? "true" : undefined}>{item.label}</a>
                                </li>
                            ))}
                        </ul>
                    </nav>
                </div>
            )}
        </header>
        <div class="site-page">
            <main class="site-main" id="content" tabindex="-1">
                <slot />
            </main>
        </div>
        <footer class="site-footer">
            <div class="site-footer-inner">
                <div class="footer-about">
                    <a class="footer-wordmark" href={homeUrl}>{siteName}</a>
                    <p>A community-maintained phylogenetic dataset for paleontology, backed by published literature.</p>
                    {/* The official marks, unchanged, in white as each brand allows beside other social
                        icons: Bluesky's butterfly (brand assets, used under its trademark policy, 4.1)
                        and the Threads logo (Meta's Threads logo pack). */}
                    <ul class="footer-social">
                        <li>
                            <a href="https://bsky.app/profile/openpaleo.bsky.social" aria-label="Open Paleo on Bluesky">
                                <svg class="social-mark" viewBox="0 0 568 501" width="23" height="20" aria-hidden="true" focusable="false"><path d="M123.121 33.6637C188.241 82.5526 258.281 181.681 284 234.873C309.719 181.681 379.759 82.5526 444.879 33.6637C491.866 -1.61183 568 -28.9064 568 57.9464C568 75.2916 558.055 203.659 552.222 224.501C531.947 296.954 458.067 315.434 392.347 304.249C507.222 323.8 536.444 388.56 473.333 453.32C353.473 576.312 301.061 422.461 287.631 383.039C285.169 375.812 284.017 372.431 284 375.306C283.983 372.431 282.831 375.812 280.369 383.039C266.939 422.461 214.527 576.312 94.6667 453.32C31.5556 388.56 60.7778 323.8 175.653 304.249C109.933 315.434 36.0535 296.954 15.7778 224.501C9.94525 203.659 0 75.2916 0 57.9464C0 -28.9064 76.1345 -1.61183 123.121 33.6637Z"></path></svg>
                            </a>
                        </li>
                        <li>
                            <a href="https://www.threads.com/@openpaleo" aria-label="Open Paleo on Threads">
                                <svg class="social-mark" viewBox="0 0 976.98 1082" width="18" height="20" aria-hidden="true" focusable="false"><path d="M770.35,500.35c-1.35-156.85-86.39-251.37-230.02-251.37-95.87,0-176.5,43.36-218.85,112.47l92.82,64.71c24.05-37.94,57.25-69.45,118.23-69.45,68.77,0,104.34,38.28,114.5,109.42-33.2-5.08-66.4-7.79-100.61-7.79-185.65,0-273.05,84.02-273.05,195.13s87.4,179.55,216.14,179.55c141.27,0,225.62-95.19,260.18-213.09,35.91,16.26,60.64,54.2,60.64,111.12,0,152.45-175.82,235.45-324.88,235.45-219.86,0-363.5-144.32-363.5-379.08,0-287.62,190.05-471.91,445.48-471.91,171.42,0,256.11,75.21,313.7,176.16l94.86-66.4C913.31,94.5,773.4,1,563.36,1,228.65,1,1,238.48,1,583.01c0,315.06,222.91,497.99,488.51,497.99,219.52,0,441.42-128.05,441.42-347.24,0-114.5-65.72-190.39-160.58-233.41h0ZM485.44,718.85c-48.44,0-91.13-23.04-91.13-65.38,0-66.74,81.98-87.06,162.27-87.06,30.49,0,60.3,2.03,86.72,7.79-18.97,86.72-75.21,144.66-157.87,144.66h0Z"></path></svg>
                            </a>
                        </li>
                    </ul>
                </div>
                <nav class="footer-column" aria-labelledby="footer-data-heading">
                    <h2 class="footer-heading" id="footer-data-heading">Data</h2>
                    <ul class="footer-links">
                        <li><a href={homeUrl + "data/"}>Download and cite the data</a></li>
                        <li><a href="https://github.com/open-paleo/data">Dataset on GitHub</a></li>
                        <li><a href="https://github.com/open-paleo/glossary">Glossary on GitHub</a></li>
                        <li><a href="https://github.com/open-paleo/web">Site source on GitHub</a></li>
                    </ul>
                </nav>
                <nav class="footer-column" aria-labelledby="footer-about-heading">
                    <h2 class="footer-heading" id="footer-about-heading">About</h2>
                    <ul class="footer-links">
                        <li><a href={homeUrl + "privacy/"}>Privacy</a></li>
                        <li><a href={homeUrl + "licenses/"}>Licenses</a></li>
                    </ul>
                </nav>
                <p class="footer-license">
                    Data by Open Paleo contributors, licensed under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.
                    Site code licensed under the <a href="https://github.com/open-paleo/web/blob/main/LICENSE">MIT License</a>;
                    the work of others it uses is listed under <a href={homeUrl + "licenses/"}>Licenses</a>.
                    Built from release {release.version}.
                </p>
            </div>
        </footer>
        <script>
            import "../scripts/search-suggestions.ts";
        </script>
    </body>
</html>

<style>
    .skip-link
    {
        position: absolute;
        top: var(--space-2);
        left: var(--space-2);
        z-index: 10;
        padding: var(--space-2) var(--space-4);
        color: var(--color-ink);
        background: var(--color-surface);
        border: 2px solid var(--color-accent);
        border-radius: var(--radius);
        font-family: var(--font-sans);
        transform: translateY(-200%);
    }

    .skip-link:focus
    {
        transform: none;
    }

    /* A full-width dark band. Its contents line up with the page content below. */
    .site-header
    {
        position: relative;
        color: var(--color-header-ink);
        background: var(--color-header-background);
        border-bottom: 1px solid var(--color-header-edge);
        font-family: var(--font-sans);
    }

    /* The header, main content and footer share one column width and side gutter. */
    .site-header-inner,
    .site-main,
    .site-footer-inner
    {
        max-width: var(--page-width);
        margin-inline: auto;
        padding-inline: max(var(--space-4), env(safe-area-inset-left, 0px)) max(var(--space-4), env(safe-area-inset-right, 0px));
    }

    /* Keeps the footer at the bottom of short pages: the body is at least as tall as the window
       and the page takes the leftover height. svh, so mobile browser bars can't hide it. The body
       has the header's band and the page between header and footer the page color, because
       Safari on iOS 26 tints its toolbars from the body's background, not the theme-color meta
       tags. */
    body
    {
        background: var(--color-header-background);
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        min-height: 100svh;
    }

    /* The page color across the window's full width, around the main content's column. */
    .site-page
    {
        flex: 1 0 auto;
        background: var(--color-background);
    }

    /* The footer repeats the header's dark band, so the two frame the page. */
    .site-footer
    {
        color: var(--color-header-muted);
        background: var(--color-header-background);
        border-top: 1px solid var(--color-header-edge);
        font-family: var(--font-sans);
        font-size: var(--text-small);
    }

    .site-footer-inner
    {
        display: grid;
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
        gap: var(--space-5) var(--space-7);
        padding-block: var(--space-6) var(--space-7);
    }

    /* Keeps the wordmark and its line together instead of spreading them to the links' height. */
    .footer-about
    {
        display: grid;
        align-content: start;
        gap: var(--space-2);
        max-width: 28rem;
    }

    /* Bluesky asks for clear space as wide as its butterfly on every side, and Threads for a
       quarter of its icon's width: the gaps and the 2rem targets give both. */
    .footer-social
    {
        display: flex;
        gap: var(--space-3);
        margin: var(--space-4) 0 0 calc(-1 * var(--space-1));
        padding: 0;
        list-style: none;
    }

    .footer-social a
    {
        display: grid;
        place-items: center;
        width: 2rem;
        height: 2rem;
    }

    /* The same height for both marks, in the white each brand allows; links don't recolor them. */
    .social-mark
    {
        height: 1.25rem;
        width: auto;
        fill: var(--color-brand-white);
    }

    .footer-wordmark
    {
        color: var(--color-header-ink);
        font-family: var(--font-serif);
        font-size: var(--text-heading-3);
        font-weight: 800;
        text-decoration: none;
    }

    .footer-column
    {
        display: grid;
        gap: var(--space-3);
        align-content: start;
    }

    .footer-heading
    {
        color: var(--color-header-ink);
        font-family: var(--font-sans);
        font-size: var(--text-small);
        font-weight: 600;
    }

    .footer-links
    {
        display: grid;
        gap: var(--space-2);
        align-content: start;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .site-footer a
    {
        color: var(--color-header-ink);
    }

    .footer-license
    {
        grid-column: 1 / -1;
        padding-top: var(--space-4);
        border-top: 1px solid var(--color-header-border);
    }

    .site-footer :focus-visible
    {
        outline-color: var(--color-header-accent);
    }

    .site-header-inner
    {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-3) var(--space-6);
        padding-block: var(--space-4);
    }

    .wordmark
    {
        color: var(--color-header-ink);
        font-family: var(--font-serif);
        font-size: var(--text-heading-2);
        font-weight: 800;
        line-height: 1;
        text-decoration: none;
    }

    .site-navigation ul
    {
        display: flex;
        flex-wrap: wrap;
        gap: var(--space-1) var(--space-5);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .site-navigation a
    {
        display: inline-block;
        padding-block: var(--space-1);
        color: var(--color-header-muted);
        font-size: var(--text-interface);
        text-decoration: none;
        border-bottom: 2px solid transparent;
    }

    .site-navigation a:hover
    {
        color: var(--color-header-ink);
    }

    .site-navigation a[aria-current]
    {
        color: var(--color-header-ink);
        border-bottom-color: var(--color-header-accent);
    }

    /* The second row: a slightly lighter band holding the current group's pages. */
    .group-navigation
    {
        background: var(--color-header-surface);
    }

    .group-navigation-inner
    {
        max-width: var(--page-width);
        margin-inline: auto;
        padding-inline: max(var(--space-4), env(safe-area-inset-left, 0px)) max(var(--space-4), env(safe-area-inset-right, 0px));
    }

    /* Room under the links, so the current page's underline sits clear of the header's edge. */
    .group-navigation ul
    {
        display: flex;
        flex-wrap: wrap;
        gap: 0 var(--space-5);
        margin: 0;
        padding: 0 0 var(--space-2);
        list-style: none;
    }

    .group-navigation a
    {
        display: inline-block;
        padding-block: var(--space-2) var(--space-1);
        color: var(--color-header-muted);
        font-size: var(--text-small);
        text-decoration: none;
        border-bottom: 2px solid transparent;
    }

    .group-navigation a:hover
    {
        color: var(--color-header-ink);
    }

    .group-navigation a[aria-current]
    {
        color: var(--color-header-ink);
        border-bottom-color: var(--color-header-accent);
    }

    /* The GitHub link starts the header's right-hand group, so it sits just left of search. */
    .github-link
    {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        margin-left: auto;
        color: var(--color-header-muted);
        border-radius: var(--radius);
    }

    .github-link:hover
    {
        color: var(--color-header-ink);
        background: var(--color-header-surface);
    }

    /* A compact field on wide screens; on phones it takes a row of its own (below). */
    .site-search
    {
        display: flex;
        flex: 0 1 18rem;
        justify-content: flex-end;
        gap: var(--space-2);
    }

    .site-search input
    {
        flex: 1 1 auto;
        min-width: 0;
        padding: var(--space-2) var(--space-3);
        color: var(--color-header-ink);
        background: var(--color-header-surface);
        border: 1px solid var(--color-header-border);
        border-radius: var(--radius);
        font-size: var(--text-interface);
    }

    .site-search input::placeholder
    {
        color: var(--color-header-muted);
    }

    /* Suggestion lists under the search fields; global because the script creates them. */
    .site-search,
    :global(.home-search-row)
    {
        position: relative;
    }

    :global(.search-suggestions)
    {
        position: absolute;
        top: calc(100% + var(--space-1));
        left: 0;
        z-index: 10;
        width: max(100%, 24rem);
        max-width: calc(100vw - 2 * var(--space-4));
        max-height: min(28rem, 70vh);
        margin: 0;
        padding: var(--space-1) 0;
        overflow-y: auto;
        color: var(--color-ink);
        background: var(--color-surface);
        border: 1px solid var(--color-line);
        border-radius: var(--radius);
        list-style: none;
        font-family: var(--font-sans);
        font-size: var(--text-interface);
        text-align: left;
    }

    /* The header's field sits at the right, so its list opens toward the left. */
    .site-search :global(.search-suggestions)
    {
        right: 0;
        left: auto;
    }

    :global(.search-suggestions[hidden])
    {
        display: none;
    }

    :global(.search-suggestions li)
    {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        justify-content: space-between;
        gap: 0 var(--space-3);
        padding: var(--space-2) var(--space-3);
        cursor: pointer;
    }

    :global(.search-suggestions li[aria-selected="true"]),
    :global(.search-suggestions li:hover)
    {
        background: var(--color-accent-soft);
    }

    :global(.search-suggestions .suggestion-name)
    {
        font-family: var(--font-serif);
        font-size: var(--text-body);
    }

    /* Long notes, such as a reference's title, always take their own line under the name. */
    :global(.search-suggestions.has-notes-below .suggestion-note)
    {
        flex-basis: 100%;
    }

    :global(.search-suggestions .suggestion-note)
    {
        color: var(--color-muted);
        font-size: var(--text-small);
    }

    :global(.search-suggestions .suggestion-query)

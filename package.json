{
  "name": "open-paleo-web",
  "version": "0.1.0",
  "description": "Static website for the Open Paleo phylogenetic dataset",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "node node_modules/typescript7/bin/tsc --noEmit && astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "spellcheck": "cspell \"**/*.md\" \"*.ts\" \"scripts/**/*.ts\" \"src/**/*.{ts,astro,css}\" --no-progress",
    "check-site": "node --experimental-strip-types scripts/check-site.ts",
    "update-bindings": "node --experimental-strip-types scripts/update-bindings.ts",
    "create-test-fixture": "node --experimental-strip-types scripts/create-test-fixture.ts",
    "create-map-shapes": "node --experimental-strip-types scripts/create-map-shapes.ts",
    "create-social-image": "node --experimental-strip-types scripts/create-social-image.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "astro-eslint-parser": "3.2.0",
    "axe-core": "4.14.0",
    "cspell": "10.4.0",
    "eslint": "10.13.0",
    "eslint-plugin-astro": "3.2.1",
    "pagefind": "1.5.2",
    "playwright": "1.64.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "typescript7": "npm:typescript@7.0.2"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@open-paleo/tree-extractor": "https://github.com/open-paleo/tree-extractor/releases/download/v0.5.1/open-paleo-tree-extractor-0.5.1.tgz",
    "@tesseract.js-data/eng": "1.0.0",
    "astro": "7.4.2",
    "maplibre-gl": "6.16.0",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.1.2"
  }
}

{
    "extends": "astro/tsconfigs/strict",
    "compilerOptions": {
        "lib": [
            "ESNext",
            "DOM",
            "DOM.Iterable"
        ],
        "types": [
            "node"
        ],
        "checkJs": true
    },
    "include": [
        ".astro/types.d.ts",
        "**/*"
    ],
    "exclude": [
        "dist",
        "node_modules",
        "scratch",
        "data",
        "test/fixtures"
    ]
}
